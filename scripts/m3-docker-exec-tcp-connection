#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 2 || ! $1 =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ || ! $2 =~ ^[0-9]+$ ]]; then
  exit 64
fi

container=$1
port=$2
if ((port < 1 || port > 65535)); then
  exit 64
fi

exec docker exec --interactive "$container" /bin/bash -c '
  exec 3<>"/dev/tcp/127.0.0.1/$1"
  /bin/cat <&3 &
  reader_pid=$!
  /bin/cat >&3
  wait "$reader_pid"
' lowerduckpond-m3-tunnel "$port"
