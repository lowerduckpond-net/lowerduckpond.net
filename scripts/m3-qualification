#!/usr/bin/env bash
set -euo pipefail

readonly repository_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
readonly evidence_root=${M3_QUALIFICATION_EVIDENCE_DIR:-"${repository_root}/.artifacts/m3-qualification"}
readonly qualification_package=/opt/lowerduckpond/m3-qualification
readonly qualification_root="${repository_root}/infra/opentofu/environments/qualification"
readonly qualification_inventory="${repository_root}/config/ansible/inventories/qualification/hosts.yml"
readonly remote_convergence_marker=/var/lib/lowerduckpond-m3/converged-session
readonly remote_report=/run/lowerduckpond-m3-qualification/host-report.json
readonly session_path="${evidence_root}/session.json"
readonly operation_lock="${evidence_root}/operation.lock"

usage() {
    echo "usage: scripts/m3-qualification {status|preflight|begin|libraries|configure TRUST|edge STAGE|host TRUST|domains ATTESTATION|browser|assemble}" >&2
    exit 64
}

create_certificate_ids_file() {
    certificate_ids_path=$(mktemp "${TMPDIR:-/tmp}/ldp-m3-certificate-ids.XXXXXXXX")
    chmod 0600 "$certificate_ids_path"
    trap 'rm -f -- "$certificate_ids_path"' EXIT
    tofu -chdir="$qualification_root" console \
        <<< 'jsonencode(var.origin_pull_certificate_ids)' | \
        jq --raw-output . > "$certificate_ids_path"
    uv run python -m json.tool "$certificate_ids_path" >/dev/null
}

require_clean_revision() {
    if [[ -n $(git -C "$repository_root" status --porcelain --untracked-files=normal) ]]; then
        echo "qualification requires a clean Git revision" >&2
        exit 65
    fi
}

current_revision() {
    git -C "$repository_root" rev-parse HEAD
}

verify_session() {
    require_clean_revision
    tofu -chdir="$qualification_root" output -json qualification_identity | \
        uv run ldp-m3-qualify verify-session \
            --session "$session_path" \
            --source-revision "$(current_revision)"
}

session_value() {
    uv run ldp-m3-qualify session-value --session "$session_path" --field "$1"
}

load_report_session() {
    verify_session
    qualification_run_id=$(session_value run_id)
    qualification_source_revision=$(session_value source_revision)
}

verify_remote_convergence() {
    trust_stage=$1
    host=$(session_value ipv4_address)
    if ! ssh -o BatchMode=yes "ldp-admin@$host" sudo cat -- "$remote_convergence_marker" | \
        uv run ldp-m3-qualify verify-convergence \
            --session "$session_path" \
            --trust-stage "$trust_stage"; then
        echo "qualification host has not converged for this run and revision" >&2
        return 65
    fi
}

cd "$repository_root"
mkdir -p -- "$evidence_root"
exec 9>>"$operation_lock"
chmod 0600 "$operation_lock"
if ! flock --exclusive --nonblock 9; then
    echo "another qualification action is already running" >&2
    exit 75
fi
if [[ $# -lt 1 ]]; then
    usage
fi

action=$1
shift
case "$action" in
    status)
        [[ $# -eq 0 ]] || usage
        if [[ ! -f $session_path ]]; then
            echo "session: absent"
            exit 0
        fi
        uv run ldp-m3-qualify report-status \
            --session "$session_path" \
            --source-revision "$(current_revision)" \
            --fragment "libraries=$evidence_root/libraries.json" \
            --fragment "host=$evidence_root/host.json" \
            --fragment "domains=$evidence_root/domains.json" \
            --fragment "browser=$evidence_root/browser.json" \
            --fragment "edge-primary=$evidence_root/edge-primary.json" \
            --fragment "edge-replacement=$evidence_root/edge-replacement.json" \
            --fragment "edge-rollback=$evidence_root/edge-rollback.json" \
            --fragment "edge-forward=$evidence_root/edge-forward.json" \
            --fragment "edge-retired-primary=$evidence_root/edge-retired-primary.json" \
            --fragment "edge-final=$evidence_root/edge-final.json" \
            --fragment "assembled=$evidence_root/m3-qualification.json"
        ;;
    preflight)
        [[ $# -eq 0 ]] || usage
        require_clean_revision
        : "${M3_QUALIFICATION_NET_ZONE_ID:?}"
        : "${M3_QUALIFICATION_COM_ZONE_ID:?}"
        : "${M3_QUALIFICATION_CLOUDFLARE_API_TOKEN:?}"
        : "${M3_QUALIFICATION_PRIMARY_CA_PATH:?}"
        : "${M3_QUALIFICATION_REPLACEMENT_CA_PATH:?}"
        create_certificate_ids_file
        uv run ldp-m3-qualify edge-preflight \
            --certificate-ids "$certificate_ids_path" \
            --net-zone-id "$M3_QUALIFICATION_NET_ZONE_ID" \
            --com-zone-id "$M3_QUALIFICATION_COM_ZONE_ID" \
            --primary-ca "$M3_QUALIFICATION_PRIMARY_CA_PATH" \
            --replacement-ca "$M3_QUALIFICATION_REPLACEMENT_CA_PATH"
        ;;
    begin)
        [[ $# -eq 0 ]] || usage
        require_clean_revision
        rm -f -- \
            "$session_path" \
            "$evidence_root/libraries.json" \
            "$evidence_root/host.json" \
            "$evidence_root/domains.json" \
            "$evidence_root/browser.json" \
            "$evidence_root/edge-primary.json" \
            "$evidence_root/edge-replacement.json" \
            "$evidence_root/edge-rollback.json" \
            "$evidence_root/edge-forward.json" \
            "$evidence_root/edge-retired-primary.json" \
            "$evidence_root/edge-final.json" \
            "$evidence_root/m3-qualification.json"
        tofu -chdir="$qualification_root" output -json qualification_identity | \
            uv run ldp-m3-qualify begin-session \
                --source-revision "$(current_revision)" \
                --output "$session_path"
        ;;
    libraries)
        [[ $# -eq 0 ]] || usage
        load_report_session
        rm -f -- "$evidence_root/libraries.json"
        uv run ldp-m3-qualify libraries \
            --run-id "$qualification_run_id" \
            --source-revision "$qualification_source_revision" \
            --output "$evidence_root/libraries.json"
        ;;
    configure)
        [[ $# -eq 1 && $1 =~ ^(dual|replacement)$ ]] || usage
        trust_stage=$1
        verify_session
        host=$(session_value ipv4_address)
        droplet_id=$(session_value droplet_id)
        run_id=$(session_value run_id)
        source_revision=$(session_value source_revision)
        admin_source_cidrs=$(tofu -chdir="$qualification_root" output -json admin_source_cidrs)
        : "${M3_QUALIFICATION_PRIMARY_CA_PATH:?}"
        : "${M3_QUALIFICATION_REPLACEMENT_CA_PATH:?}"
        M3_QUALIFICATION_EXPECTED_IPV4="$host" \
            M3_QUALIFICATION_EXPECTED_DROPLET_ID="$droplet_id" \
            M3_QUALIFICATION_EXPECTED_RUN_ID="$run_id" \
            M3_QUALIFICATION_EXPECTED_SOURCE_REVISION="$source_revision" \
            M3_QUALIFICATION_EXPECTED_ADMIN_SOURCE_CIDRS_JSON="$admin_source_cidrs" \
            M3_QUALIFICATION_ORIGIN_PULL_TRUST="$trust_stage" \
            ANSIBLE_CONFIG="$repository_root/config/ansible/ansible.cfg" \
            uv run ansible-playbook \
                --inventory "$qualification_inventory" \
                "$repository_root/config/ansible/playbooks/m3-qualification.yml"
        ;;
    host)
        [[ $# -eq 1 && $1 =~ ^(dual|replacement)$ ]] || usage
        trust_stage=$1
        load_report_session
        verify_remote_convergence "$trust_stage"
        rm -f -- "$evidence_root/host.json"
        ssh -o BatchMode=yes "ldp-admin@$host" sudo rm -f -- "$remote_report"
        set +e
        ssh -o BatchMode=yes "ldp-admin@$host" \
            sudo env "PYTHONPATH=$qualification_package" /usr/bin/python3 \
            -m lowerduckpond_m3_qualification host \
            --run-id "$qualification_run_id" \
            --source-revision "$qualification_source_revision" \
            --trust-stage "$trust_stage" \
            --work-root /var/lib/lowerduckpond-m3 \
            --output "$remote_report"
        remote_status=$?
        set -e
        temporary_host_report=$(mktemp "$evidence_root/.host.json.XXXXXXXX")
        trap '[[ -z $temporary_host_report ]] || rm -f -- "$temporary_host_report"' EXIT
        if ssh -o BatchMode=yes "ldp-admin@$host" sudo cat -- "$remote_report" \
            > "$temporary_host_report"; then
            mv -- "$temporary_host_report" "$evidence_root/host.json"
            temporary_host_report=
        else
            echo "host probe did not produce a sanitized report" >&2
            if [[ $remote_status -eq 0 ]]; then
                remote_status=1
            fi
        fi
        exit "$remote_status"
        ;;
    edge)
        [[ $# -eq 1 && $1 =~ ^(primary|replacement|rollback|forward|retired-primary|final)$ ]] || usage
        edge_stage=$1
        load_report_session
        : "${M3_QUALIFICATION_NET_ZONE_ID:?}"
        : "${M3_QUALIFICATION_COM_ZONE_ID:?}"
        : "${M3_QUALIFICATION_CLOUDFLARE_API_TOKEN:?}"
        case "$edge_stage" in
            primary|rollback|retired-primary)
                expected_generation=primary
                ;;
            replacement|forward|final)
                expected_generation=replacement
                ;;
        esac
        case "$edge_stage" in
            primary|replacement|rollback|forward)
                trust_stage=dual
                ;;
            retired-primary|final)
                trust_stage=replacement
                ;;
        esac
        selected_generation=$(tofu -chdir="$qualification_root" output -raw origin_pull_generation)
        if [[ "$selected_generation" != "$expected_generation" ]]; then
            echo "qualification state selects $selected_generation, not $expected_generation" >&2
            exit 65
        fi
        verify_remote_convergence "$trust_stage"
        create_certificate_ids_file
        rm -f -- "$evidence_root/edge-$edge_stage.json"
        uv run ldp-m3-qualify edge \
            --run-id "$qualification_run_id" \
            --source-revision "$qualification_source_revision" \
            --stage "$edge_stage" \
            --origin-ipv4 "$host" \
            --certificate-ids "$certificate_ids_path" \
            --net-zone-id "$M3_QUALIFICATION_NET_ZONE_ID" \
            --com-zone-id "$M3_QUALIFICATION_COM_ZONE_ID" \
            --output "$evidence_root/edge-$edge_stage.json"
        ;;
    domains)
        [[ $# -eq 1 ]] || usage
        load_report_session
        : "${M3_QUALIFICATION_NET_ZONE_ID:?}"
        : "${M3_QUALIFICATION_COM_ZONE_ID:?}"
        rm -f -- "$evidence_root/domains.json"
        uv run ldp-m3-qualify domains \
            --run-id "$qualification_run_id" \
            --source-revision "$qualification_source_revision" \
            --attestation "$1" \
            --net-zone-id "$M3_QUALIFICATION_NET_ZONE_ID" \
            --com-zone-id "$M3_QUALIFICATION_COM_ZONE_ID" \
            --output "$evidence_root/domains.json"
        ;;
    browser)
        [[ $# -eq 0 ]] || usage
        : "${M3_QUALIFICATION_PLAYWRIGHT_WS_ENDPOINT:?live browser qualification requires the pinned Playwright endpoint}"
        load_report_session
        verify_remote_convergence replacement
        rm -f -- "$evidence_root/browser.json"
        uv run ldp-m3-qualify browser \
            --run-id "$qualification_run_id" \
            --source-revision "$qualification_source_revision" \
            --platform-origin https://m3-qualification.lowerduckpond.net \
            --tenant-alias-origin https://m3-a.lowerduckpond.com \
            --tenant-immutable-origin https://t-0198d17f6f4a70008000000000000001.lowerduckpond.com \
            --tenant-unknown-origin https://m3-unknown.lowerduckpond.com \
            --ws-endpoint "$M3_QUALIFICATION_PLAYWRIGHT_WS_ENDPOINT" \
            --output "$evidence_root/browser.json"
        ;;
    assemble)
        [[ $# -eq 0 ]] || usage
        load_report_session
        verify_remote_convergence replacement
        rm -f -- "$evidence_root/m3-qualification.json"
        uv run ldp-m3-qualify assemble --require-m3 \
            --fragment "$evidence_root/libraries.json" \
            --fragment "$evidence_root/host.json" \
            --fragment "$evidence_root/domains.json" \
            --fragment "$evidence_root/browser.json" \
            --fragment "$evidence_root/edge-primary.json" \
            --fragment "$evidence_root/edge-replacement.json" \
            --fragment "$evidence_root/edge-rollback.json" \
            --fragment "$evidence_root/edge-forward.json" \
            --fragment "$evidence_root/edge-retired-primary.json" \
            --fragment "$evidence_root/edge-final.json" \
            --output "$evidence_root/m3-qualification.json"
        ;;
    *)
        usage
        ;;
esac
