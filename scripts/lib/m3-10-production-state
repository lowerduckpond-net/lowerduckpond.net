# Sourced only by trusted-workstation M3.10 wrappers. Never persist outputs.
set +x

required_state_environment=(
    OPENTOFU_ENCRYPTION_PASSPHRASE
    OPENTOFU_STATE_ACCESS_KEY_ID
    OPENTOFU_STATE_BUCKET
    OPENTOFU_STATE_SECRET_ACCESS_KEY
    SPACES_REGION
)
for variable_name in "${required_state_environment[@]}"; do
    if [[ -z ${!variable_name:-} ]]; then
        echo "Required environment variable ${variable_name} is not set." >&2
        exit 2
    fi
done
if [[ ! ${SPACES_REGION} =~ ^[a-z]{3}[1-9][0-9]?$ ]]; then
    echo "SPACES_REGION is not a supported regional identifier." >&2
    exit 2
fi

production_root="${repository_root}/infra/opentofu/environments/production"
export AWS_ACCESS_KEY_ID=${OPENTOFU_STATE_ACCESS_KEY_ID}
export AWS_SECRET_ACCESS_KEY=${OPENTOFU_STATE_SECRET_ACCESS_KEY}
export TF_VAR_state_encryption_passphrase=${OPENTOFU_ENCRYPTION_PASSPHRASE}
tofu -chdir="${production_root}" init -input=false -reconfigure \
    -lockfile=readonly \
    -backend-config="bucket=${OPENTOFU_STATE_BUCKET}" \
    -backend-config="key=production/opentofu.tfstate" \
    -backend-config="region=us-east-1" \
    -backend-config="endpoints={s3=\"https://${SPACES_REGION}.digitaloceanspaces.com\"}" \
    -backend-config="skip_credentials_validation=true" \
    -backend-config="skip_requesting_account_id=true" \
    -backend-config="skip_metadata_api_check=true" \
    -backend-config="skip_region_validation=true" \
    -backend-config="skip_s3_checksum=true" \
    -backend-config="use_lockfile=false" >/dev/null

export PRODUCTION_ORIGIN_IPV4
PRODUCTION_ORIGIN_IPV4=$(tofu -chdir="${production_root}" output -json ansible_inventory |
    uv run --quiet --frozen python "${repository_root}/scripts/read_production_ansible_inventory.py")
if [[ $(tofu -chdir="${production_root}" output -raw edge_rollout_phase) != enforced ]]; then
    echo "M3.10 requires the existing enforced production edge phase." >&2
    exit 2
fi
export SPACES_ARCHIVE_BUCKET SPACES_ARCHIVE_ACCESS_KEY_ID SPACES_ARCHIVE_SECRET_ACCESS_KEY
export SPACES_BACKUP_BUCKET SPACES_BACKUP_ACCESS_KEY_ID SPACES_BACKUP_SECRET_ACCESS_KEY
SPACES_ARCHIVE_BUCKET=$(tofu -chdir="${production_root}" output -raw archive_bucket_name)
SPACES_ARCHIVE_ACCESS_KEY_ID=$(tofu -chdir="${production_root}" output -raw archive_runtime_access_key_id)
SPACES_ARCHIVE_SECRET_ACCESS_KEY=$(tofu -chdir="${production_root}" output -raw archive_runtime_secret_access_key)
SPACES_BACKUP_BUCKET=$(tofu -chdir="${production_root}" output -raw backup_bucket_name)
SPACES_BACKUP_ACCESS_KEY_ID=$(tofu -chdir="${production_root}" output -raw backup_runtime_access_key_id)
SPACES_BACKUP_SECRET_ACCESS_KEY=$(tofu -chdir="${production_root}" output -raw backup_runtime_secret_access_key)
