#!/usr/bin/env bash
set -euo pipefail
umask 077

repository_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
allow_failed_caddy_recovery=false
case ${1:-} in
    "") ;;
    --allow-exact-failed-caddy-recovery)
        allow_failed_caddy_recovery=true
        ;;
    *)
        echo "Usage: $0 [--allow-exact-failed-caddy-recovery]" >&2
        exit 2
        ;;
esac
[[ $# -le 1 ]] || {
    echo "Usage: $0 [--allow-exact-failed-caddy-recovery]" >&2
    exit 2
}
required_environment=(
    ANSIBLE_PRIVATE_KEY_FILE
)

for variable_name in "${required_environment[@]}"; do
    if [[ -z ${!variable_name:-} ]]; then
        echo "Required environment variable ${variable_name} is not set." >&2
        exit 2
    fi
done

for command_name in cmp git ssh ssh-keygen tar; do
    if ! command -v "${command_name}" >/dev/null 2>&1; then
        echo "Required command ${command_name} is not installed." >&2
        exit 2
    fi
done

if [[ ! -f ${ANSIBLE_PRIVATE_KEY_FILE} ]]; then
    echo "ANSIBLE_PRIVATE_KEY_FILE must name a regular file." >&2
    exit 2
fi
git -C "${repository_root}" fetch --quiet origin main
if [[ $(git -C "${repository_root}" branch --show-current) != main ]] ||
   [[ -n $(git -C "${repository_root}" status --short) ]] ||
   ! git -C "${repository_root}" show-ref --verify --quiet refs/remotes/origin/main ||
   [[ $(git -C "${repository_root}" rev-parse HEAD) != \
      $(git -C "${repository_root}" rev-parse origin/main) ]]; then
    echo "Production convergence requires clean, current main." >&2
    exit 2
fi
if ! ssh-keygen -F lowerduckpond.net >/dev/null; then
    echo "lowerduckpond.net is absent from the verified SSH known_hosts file." >&2
    exit 2
fi

production_ssh_host=${PRODUCTION_ORIGIN_IPV4:-lowerduckpond.net}
if [[ ${production_ssh_host} != lowerduckpond.net ]]; then
    if [[ ! ${production_ssh_host} =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        echo "PRODUCTION_ORIGIN_IPV4 must be one IPv4 address." >&2
        exit 2
    fi
    IFS=. read -r -a production_ssh_octets <<<"${production_ssh_host}"
    for production_ssh_octet in "${production_ssh_octets[@]}"; do
        if ((10#${production_ssh_octet} > 255)); then
            echo "PRODUCTION_ORIGIN_IPV4 must be one IPv4 address." >&2
            exit 2
        fi
    done
fi

working_directory=$(mktemp -d)
cleanup() {
    chmod --recursive u+w "${working_directory}" 2>/dev/null || true
    find "${working_directory}" -depth -delete
}
trap cleanup EXIT

first_artifact="${working_directory}/static-host-agent-first.tar"
second_artifact="${working_directory}/static-host-agent-second.tar"
first_digest=$("${repository_root}/scripts/build-static-host-agent" "${first_artifact}")
second_digest=$("${repository_root}/scripts/build-static-host-agent" "${second_artifact}")
if [[ ${first_digest} != "${second_digest}" ]] ||
   ! cmp --silent "${first_artifact}" "${second_artifact}"; then
    echo "The locked host-agent build was not reproducible." >&2
    exit 1
fi
mkdir "${working_directory}/extracted"
tar --extract --same-permissions --file "${first_artifact}" \
    --directory "${working_directory}/extracted" --strip-components=1
chmod 0555 "${working_directory}/extracted"
uv run \
    --quiet \
    --directory "${repository_root}" \
    --frozen \
    --python 3.14 \
    python -I \
    "${repository_root}/config/ansible/roles/static_host_agent/files/verify-static-host-agent-artifact" \
    --current-owner \
    "${working_directory}/extracted"

ssh \
    -o BatchMode=yes \
    -o HostKeyAlias=lowerduckpond.net \
    -o IdentitiesOnly=yes \
    -o StrictHostKeyChecking=yes \
    -i "${ANSIBLE_PRIVATE_KEY_FILE}" \
    "ldp-admin@${production_ssh_host}" \
    "sudo --non-interactive /bin/bash -s -- ${allow_failed_caddy_recovery}" <<'REMOTE'
set -euo pipefail

allow_failed_caddy_recovery=$1

remote_fail() {
    printf 'M3.5 production preflight failed: %s\n' "$1" >&2
    exit 1
}

[[ $(uname -m) == x86_64 ]] || remote_fail "host architecture is not x86-64"
provisioner_home=/var/lib/lowerduckpond/provisioner
if [[ -e ${provisioner_home} || -L ${provisioner_home} ]]; then
    [[ -d ${provisioner_home} && ! -L ${provisioner_home} ]] ||
        remote_fail "retired provisioner home has an unexpected type"
    while IFS= read -r -d '' entry; do
        name=${entry##*/}
        case ${name} in
            .bash_logout | .bashrc | .profile) ;;
            .cloud-locale-test.skip)
                [[ -f ${entry} && ! -L ${entry} ]] ||
                    remote_fail "cloud-init locale marker has an unexpected type"
                [[ $(stat --format='%U:%G:%a:%s' -- "${entry}") == \
                    ldp-provisioner:ldp-provisioner:644:0 ]] ||
                    remote_fail "cloud-init locale marker metadata drifted"
                continue
                ;;
            *) remote_fail "retired provisioner home contains an unexpected object" ;;
        esac
        [[ -f ${entry} && ! -L ${entry} ]] ||
            remote_fail "retired provisioner skeleton file has an unexpected type"
        [[ $(stat --format='%U:%G:%a' -- "${entry}") == \
            ldp-provisioner:ldp-provisioner:644 ]] ||
            remote_fail "retired provisioner skeleton file metadata drifted"
        cmp --silent -- "${entry}" "/etc/skel/${name}" ||
            remote_fail "retired provisioner skeleton file content drifted"
    done < <(find "${provisioner_home}" -mindepth 1 -maxdepth 1 -print0)
fi

for path in \
    /var/lib/lowerduckpond/jobs \
    /var/lib/lowerduckpond/manifests \
    /var/lib/lowerduckpond/audit
do
    if [[ -e ${path} || -L ${path} ]]; then
        [[ -d ${path} && ! -L ${path} ]] ||
            remote_fail "${path} has an unexpected type"
        [[ -z $(find "${path}" -mindepth 1 -print -quit) ]] ||
            remote_fail "${path} contains tenant history or an unexpected object"
    fi
done
[[ -z $(find /etc/caddy/routes.d -mindepth 1 -print -quit) ]] ||
    remote_fail "Caddy has a tenant route input"
if systemctl is-active --quiet caddy.service; then
    curl --silent --show-error --fail \
        --connect-timeout 5 --max-time 15 \
        --resolve lowerduckpond.net:443:127.0.0.1 \
        https://lowerduckpond.net/ >/dev/null ||
        remote_fail "the local HTTPS fixture failed"
elif [[ ${allow_failed_caddy_recovery} == true ]]; then
    [[ $(systemctl show --value --property=LoadState caddy.service) == loaded ]] ||
        remote_fail "Caddy recovery state is not loaded"
    [[ $(systemctl show --value --property=ActiveState caddy.service) == failed ]] ||
        remote_fail "Caddy recovery state is not failed"
    [[ $(systemctl show --value --property=SubState caddy.service) == failed ]] ||
        remote_fail "Caddy recovery substate is not failed"
    [[ $(systemctl show --value --property=Result caddy.service) == exit-code ]] ||
        remote_fail "Caddy recovery result is not exit-code"
    recovery_state=$(systemctl show \
        --property=LoadState \
        --property=ActiveState \
        --property=SubState \
        --property=Result \
        --property=NRestarts \
        caddy-recovery.service)
    [[ ${recovery_state} == $'LoadState=loaded\nActiveState=failed\nSubState=failed\nResult=start-limit-hit\nNRestarts=0' ]] ||
        remote_fail "the Caddy recovery unit is not in its exact quiescent state"
    queued_caddy_job=$(systemctl list-jobs --no-legend --plain | awk \
        '$2 == "caddy.service" || $2 == "caddy-recovery.service" { print; exit }')
    [[ -z ${queued_caddy_job} ]] ||
        remote_fail "a Caddy or Caddy-recovery systemd job remains queued"
    printf 'Exact failed Caddy recovery state accepted for guarded convergence.\n'
else
    remote_fail "Caddy is not active"
fi
REMOTE

printf 'M3.5 production preflight passed without changing host state.\n'
printf 'Pinned host-agent artifact SHA-256: %s\n' "${first_digest}"
