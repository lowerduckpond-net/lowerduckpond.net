#!/usr/bin/env bash
# Disable inherited tracing before reading any production credential inputs.
set +x
set -euo pipefail
umask 077

repository_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
production_root="${repository_root}/infra/opentofu/environments/production"
inventory="${repository_root}/config/ansible/inventories/production/hosts.yml"
site_playbook="${repository_root}/config/ansible/playbooks/site.yml"
acceptance_playbook="${repository_root}/config/ansible/playbooks/acceptance.yml"

required_environment=(
    ADMIN_SOURCE_CIDRS_JSON
    ANSIBLE_PRIVATE_KEY_FILE
    CADDY_CLOUDFLARE_API_TOKEN
    CADDY_ORIGIN_PULL_CA_PATHS_JSON
    CADDY_ORIGIN_PULL_ENFORCEMENT_ENABLED
    OPENTOFU_ENCRYPTION_PASSPHRASE
    OPENTOFU_STATE_ACCESS_KEY_ID
    OPENTOFU_STATE_BUCKET
    OPENTOFU_STATE_SECRET_ACCESS_KEY
    RESTIC_PASSWORD
    SPACES_REGION
    STATIC_OPERATOR_PRINCIPAL
    STATIC_OPERATOR_PUBLIC_KEY
)

for variable_name in "${required_environment[@]}"; do
    if [[ -z ${!variable_name:-} ]]; then
        echo "Required environment variable ${variable_name} is not set." >&2
        exit 2
    fi
done

if [[ ${CADDY_ORIGIN_PULL_ENFORCEMENT_ENABLED} != "true" &&
      ${CADDY_ORIGIN_PULL_ENFORCEMENT_ENABLED} != "false" ]]; then
    echo "CADDY_ORIGIN_PULL_ENFORCEMENT_ENABLED must be exactly true or false." >&2
    exit 2
fi

for command_name in git sha256sum ssh-keygen tofu uv; do
    if ! command -v "${command_name}" >/dev/null 2>&1; then
        echo "Required command ${command_name} is not installed." >&2
        exit 2
    fi
done

if [[ ! -f ${ANSIBLE_PRIVATE_KEY_FILE} ]]; then
    echo "ANSIBLE_PRIVATE_KEY_FILE does not name a regular file." >&2
    exit 2
fi

if ! ssh-keygen -F lowerduckpond.net >/dev/null; then
    cat >&2 <<'MESSAGE'
lowerduckpond.net is absent from your SSH known_hosts file. Verify the current
host key through an independent DigitalOcean console session, then record the
verified key before running production configuration.
MESSAGE
    exit 2
fi

git -C "${repository_root}" fetch --quiet origin main
if [[ $(git -C "${repository_root}" branch --show-current) != main ]] ||
   [[ -n $(git -C "${repository_root}" status --short) ]] ||
   ! git -C "${repository_root}" show-ref --verify --quiet \
       refs/remotes/origin/main ||
   [[ $(git -C "${repository_root}" rev-parse HEAD) != \
      $(git -C "${repository_root}" rev-parse origin/main) ]]; then
    echo "Production convergence requires clean, current main." >&2
    exit 2
fi

export AWS_ACCESS_KEY_ID=${OPENTOFU_STATE_ACCESS_KEY_ID}
export AWS_SECRET_ACCESS_KEY=${OPENTOFU_STATE_SECRET_ACCESS_KEY}
export TF_VAR_state_encryption_passphrase=${OPENTOFU_ENCRYPTION_PASSPHRASE}

tofu -chdir="${production_root}" init -input=false -reconfigure \
    -lockfile=readonly \
    -backend-config="bucket=${OPENTOFU_STATE_BUCKET}" \
    -backend-config="key=production/opentofu.tfstate" \
    -backend-config="region=us-east-1" \
    -backend-config="endpoints={s3=\"https://${SPACES_REGION}.digitaloceanspaces.com\"}" \
    -backend-config="skip_credentials_validation=true" \
    -backend-config="skip_requesting_account_id=true" \
    -backend-config="skip_metadata_api_check=true" \
    -backend-config="skip_region_validation=true" \
    -backend-config="skip_s3_checksum=true" \
    -backend-config="use_lockfile=false"

if ! production_origin_ipv4=$(tofu -chdir="${production_root}" \
    output -json ansible_inventory | uv run --quiet python \
    "${repository_root}/scripts/read_production_ansible_inventory.py"); then
    exit 1
fi
export PRODUCTION_ORIGIN_IPV4=${production_origin_ipv4}

# The first M3.10 upgrade needs its live gate in addition to the general host
# checks. Artifact selection alone does not prove a completed installation.
selected_production_artifact=$(ssh \
    -o BatchMode=yes -o HostKeyAlias=lowerduckpond.net -o IdentitiesOnly=yes \
    -o StrictHostKeyChecking=yes -o ConnectTimeout=15 \
    -i "${ANSIBLE_PRIVATE_KEY_FILE}" "ldp-admin@${PRODUCTION_ORIGIN_IPV4}" \
    'readlink --canonicalize-existing /opt/lowerduckpond/static-host-agent/current')

export SPACES_BACKUP_ACCESS_KEY_ID
SPACES_BACKUP_ACCESS_KEY_ID=$(tofu -chdir="${production_root}" \
    output -raw backup_runtime_access_key_id)
export SPACES_BACKUP_SECRET_ACCESS_KEY
SPACES_BACKUP_SECRET_ACCESS_KEY=$(tofu -chdir="${production_root}" \
    output -raw backup_runtime_secret_access_key)
backup_bucket_name=$(tofu -chdir="${production_root}" output -raw backup_bucket_name)
export SPACES_BACKUP_BUCKET=${backup_bucket_name}
export BACKUP_REPOSITORY="s3:https://${SPACES_REGION}.digitaloceanspaces.com/${backup_bucket_name}/backups/lowerduckpond-production-01"

# The archive service receives its own bucket-only key, separately from Restic.
export SPACES_ARCHIVE_ACCESS_KEY_ID
SPACES_ARCHIVE_ACCESS_KEY_ID=$(tofu -chdir="${production_root}" \
    output -raw archive_runtime_access_key_id)
export SPACES_ARCHIVE_SECRET_ACCESS_KEY
SPACES_ARCHIVE_SECRET_ACCESS_KEY=$(tofu -chdir="${production_root}" \
    output -raw archive_runtime_secret_access_key)
export SPACES_ARCHIVE_BUCKET
SPACES_ARCHIVE_BUCKET=$(tofu -chdir="${production_root}" output -raw archive_bucket_name)

temporary_directory=$(mktemp -d)
preserve_private_diagnostics=false
cleanup() {
    if [[ ${preserve_private_diagnostics} == true ]]; then
        printf 'Private convergence diagnostics retained at %s.\n' "${temporary_directory}" >&2
    else
        find "${temporary_directory}" -depth -delete
    fi
}
trap cleanup EXIT
second_converge_output="${temporary_directory}/second-converge.log"

rollback_artifact_path=${M3_DARK_HOST_ROLLBACK_ARTIFACT_PATH:-}
rollback_artifact_sha256=${M3_DARK_HOST_ROLLBACK_ARTIFACT_SHA256:-}
if [[ -n ${rollback_artifact_path} || -n ${rollback_artifact_sha256} ]]; then
    rollback_artifact_actual_sha256=""
    if [[ -f ${rollback_artifact_path} && ! -L ${rollback_artifact_path} ]]; then
        rollback_artifact_actual_sha256=$(sha256sum -- "${rollback_artifact_path}")
        rollback_artifact_actual_sha256=${rollback_artifact_actual_sha256%% *}
    fi
    if [[ -z ${rollback_artifact_path} || -z ${rollback_artifact_sha256} ]] ||
       [[ ${rollback_artifact_path} != /* ]] ||
       [[ ! -f ${rollback_artifact_path} || -L ${rollback_artifact_path} ]] ||
       [[ ! ${rollback_artifact_sha256} =~ ^[0-9a-f]{64}$ ]] ||
       [[ ${rollback_artifact_actual_sha256} != "${rollback_artifact_sha256}" ]]; then
        echo "The explicit M3.5 rollback artifact is incomplete or invalid." >&2
        exit 2
    fi
    export STATIC_HOST_AGENT_ARTIFACT_PATH=${rollback_artifact_path}
    export STATIC_HOST_AGENT_ARTIFACT_SHA256=${rollback_artifact_sha256}
    echo "Selecting the explicitly pinned M3.5 rollback artifact."
else
    export STATIC_HOST_AGENT_ARTIFACT_PATH="${temporary_directory}/static-host-agent.tar"
    export STATIC_HOST_AGENT_ARTIFACT_SHA256
    STATIC_HOST_AGENT_ARTIFACT_SHA256=$(
        "${repository_root}/scripts/build-static-host-agent" \
            "${STATIC_HOST_AGENT_ARTIFACT_PATH}"
    )
fi

export ANSIBLE_CONFIG="${repository_root}/config/ansible/ansible.cfg"
export ANSIBLE_PRIVATE_KEY_FILE

[[ ${STATIC_HOST_AGENT_ARTIFACT_SHA256} =~ ^[0-9a-f]{64}$ ]] || exit 2
production_source_revision=$(git -C "${repository_root}" rev-parse HEAD)
completion_source_revision=${production_source_revision}
[[ ${production_source_revision} =~ ^[0-9a-f]{40}$ ]] || exit 2
convergence_state() {
    ssh -o BatchMode=yes -o HostKeyAlias=lowerduckpond.net -o IdentitiesOnly=yes \
        -o StrictHostKeyChecking=yes -o ConnectTimeout=15 \
        -i "${ANSIBLE_PRIVATE_KEY_FILE}" "ldp-admin@${PRODUCTION_ORIGIN_IPV4}" \
        "sudo --non-interactive /bin/bash -s -- $1 ${STATIC_HOST_AGENT_ARTIFACT_SHA256} ${completion_source_revision} ${production_storage_target:-}" \
        <"${repository_root}/scripts/m3-10-convergence-state"
}

completed_host=false
completed_candidate=false
preserve_completed_history=false
if [[ -z ${rollback_artifact_path} ]]; then
    if completed_record=$(ssh -o BatchMode=yes -o HostKeyAlias=lowerduckpond.net -o IdentitiesOnly=yes \
        -o StrictHostKeyChecking=yes -o ConnectTimeout=15 \
        -i "${ANSIBLE_PRIVATE_KEY_FILE}" "ldp-admin@${PRODUCTION_ORIGIN_IPV4}" \
        'sudo --non-interactive /bin/bash -s -- inspect' \
        <"${repository_root}/scripts/m3-10-convergence-state"); then
        [[ ${completed_record} =~ ^[0-9a-f]{64}\ [0-9a-f]{40}(\ [0-9a-f]{64})?$ ]] || exit 1
        completed_artifact=${completed_record%% *}
        completed_remainder=${completed_record#* }
        completed_source=${completed_remainder%% *}
        completed_storage_target=""
        if [[ ${completed_remainder} == *" "* ]]; then
            completed_storage_target=${completed_remainder#* }
        fi
        [[ ${selected_production_artifact} == "/opt/lowerduckpond/static-host-agent/${completed_artifact}" ]] || exit 1
        if ! git -C "${repository_root}" merge-base --is-ancestor \
            "${completed_source}" "${production_source_revision}"; then
            echo "The completed production source must be available in the candidate's history." >&2
            exit 1
        fi
        completed_host=true
        if [[ ${completed_artifact} == "${STATIC_HOST_AGENT_ARTIFACT_SHA256}" ]]; then
            preserve_completed_history=true
        fi
    else
        completion_status=$?
        if ((completion_status != 3)); then
            echo "The existing production completion record could not be verified." >&2
            exit 1
        fi
    fi
fi
if [[ -z ${rollback_artifact_path} ]]; then
    input_arguments=(--source "${production_source_revision}" --artifact "${STATIC_HOST_AGENT_ARTIFACT_SHA256}")
    if [[ ${preserve_completed_history} == true ]]; then
        input_arguments+=(--completed-source "${completed_source}" --completed-storage-target "${completed_storage_target}")
    fi
    input_status=$(uv run --quiet --frozen python -m scripts.production_qualification_inputs "${input_arguments[@]}")
    [[ ${input_status} =~ ^(completed|changed)\ [0-9a-f]{64}$ ]] || exit 1
    production_storage_target=${input_status#* }
    case ${input_status%% *} in
        completed)
            [[ ${preserve_completed_history} == true ]] || exit 1
            completed_candidate=true
            # A bookkeeping descendant does not rewrite accepted provenance.
            completion_source_revision=${completed_source}
            ;;
        changed) ;;
        *) exit 1 ;;
    esac
fi
# Existing host authority and candidate qualification are separate. A changed
# source never erases a validated previous installation or becomes M3.9 again.
if [[ ${completed_host} == true ]]; then
    "${repository_root}/scripts/check-m3-6-operator-identity" "${ANSIBLE_PRIVATE_KEY_FILE}"
    "${repository_root}/scripts/preflight-m3-dark-host-production"
    completed_host_mode=completed-host
    if [[ ${preserve_completed_history} != true ]]; then
        completed_host_mode=upgrade-host
    fi
    ssh -o BatchMode=yes -o HostKeyAlias=lowerduckpond.net -o IdentitiesOnly=yes \
        -o StrictHostKeyChecking=yes -o ConnectTimeout=15 \
        -i "${ANSIBLE_PRIVATE_KEY_FILE}" "ldp-admin@${PRODUCTION_ORIGIN_IPV4}" \
        "sudo --non-interactive /bin/bash -s -- ${completed_artifact} ${completed_host_mode} ${completed_source}" \
        <"${repository_root}/scripts/m3-10-completed-host-preflight" \
        >"${temporary_directory}/archive-authority.json"
else
    "${repository_root}/scripts/preflight-m3-6-production" \
        --allow-exact-failed-caddy-recovery
fi
if [[ -z ${rollback_artifact_path} && ${completed_candidate} != true ]]; then
    if [[ -z ${M3_10_QUALIFICATION_REPORT:-} ||
          ${M3_10_ARCHIVE_CREDENTIAL_BACKUP_CONFIRMED:-} != true ]]; then
        echo "A new production candidate requires its live qualification report and confirmed secure-workstation credential backup." >&2
        exit 2
    fi
    uv run --quiet --frozen python -m scripts.m3_10_qualification_report \
        "${M3_10_QUALIFICATION_REPORT}" --verify \
        --source "${production_source_revision}" \
        --artifact "${STATIC_HOST_AGENT_ARTIFACT_SHA256}"
fi
if [[ -z ${rollback_artifact_path} && ${completed_host} != true ]]; then
    "${repository_root}/scripts/preflight-m3-10-production"
elif [[ -z ${rollback_artifact_path} ]]; then
    # Completion cannot attest to mutable provider policy or current firewall
    # enforcement. Recheck those controls without requiring an empty archive
    # or the preceding M3.9 host that the first-convergence gate requires.
    uv run --quiet --frozen python -m scripts.check_m3_10_provider --allow-existing-archives \
        --archive-authority "${temporary_directory}/archive-authority.json" \
        --artifact "${completed_artifact}" --source "${completed_source}"
    uv run --quiet --frozen python -m scripts.check_m3_10_host_firewall
fi

if [[ -z ${rollback_artifact_path} ]]; then
    # Exercise the exact freshly loaded runtime keys, including versioned
    # writes/deletes and mutual bucket denial, before installing either key.
    # This small storage proof supplements the full installed qualification.
    current_credential_check() {
        local -a storage_arguments=(
            --backup-bucket "${backup_bucket_name}" --archive-bucket "${SPACES_ARCHIVE_BUCKET}"
            --region "${SPACES_REGION}"
        )
        if [[ ${completed_host} == true ]]; then
            uv run --quiet --frozen ldp-m3-archive credential-check "${storage_arguments[@]}"
        else
            uv run --quiet --frozen ldp-m3-archive acceptance "${storage_arguments[@]}" \
                --source-revision "${production_source_revision}" \
                --output "${temporary_directory}/current-storage.json" &&
            uv run --quiet --frozen ldp-m3-archive verify-report \
                "${temporary_directory}/current-storage.json"
        fi
    }
    if ! current_credential_check >"${temporary_directory}/current-storage.log" 2>&1; then
        preserve_private_diagnostics=true
        echo "Current archive/backup credential qualification failed before host mutation." >&2
        exit 1
    fi
fi

# Any interrupted attempt, including rollback, invalidates prior completion.
# A partial installation without completion still requires investigation;
# neither artifact selection nor a fresh report invents a completed predecessor.
printf '{"static_host_agent_verified_completed_candidate":%s}\n' \
    "${preserve_completed_history}" >"${temporary_directory}/convergence-authorization.json"
convergence_arguments=(--extra-vars "@${temporary_directory}/convergence-authorization.json")
convergence_state clear
echo "Converging the production hosting node."
uv run ansible-playbook --inventory "${inventory}" "${site_playbook}" "${convergence_arguments[@]}"

echo "Reapplying the production configuration to prove idempotence."
uv run ansible-playbook --inventory "${inventory}" "${site_playbook}" "${convergence_arguments[@]}" |
    tee "${second_converge_output}"

if ! grep --extended-regexp --quiet \
    'changed=0[[:space:]]+unreachable=0[[:space:]]+failed=0' \
    "${second_converge_output}"; then
    echo "The second production converge was not idempotent." >&2
    exit 1
fi

echo "Running production host acceptance checks, including a disposable restore."
uv run ansible-playbook --inventory "${inventory}" "${acceptance_playbook}"

if [[ -z ${rollback_artifact_path} ]]; then
    convergence_state record
fi
