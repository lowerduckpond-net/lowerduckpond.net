#!/usr/bin/env bash
set -euo pipefail
umask 077
export LC_ALL=C

repository_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
required_environment=(
    ANSIBLE_PRIVATE_KEY_FILE
    STATIC_OPERATOR_PRINCIPAL
    STATIC_OPERATOR_PUBLIC_KEY
)

for variable_name in "${required_environment[@]}"; do
    if [[ -z ${!variable_name:-} ]]; then
        echo "Required environment variable ${variable_name} is not set." >&2
        exit 2
    fi
done

"${repository_root}/scripts/check-m3-6-operator-identity" \
    "${ANSIBLE_PRIVATE_KEY_FILE}"
dark_host_preflight_output=$(
    "${repository_root}/scripts/preflight-m3-dark-host-production"
)
printf '%s\n' "${dark_host_preflight_output}"
artifact_digest=""
while IFS= read -r output_line; do
    case ${output_line} in
        'Pinned host-agent artifact SHA-256: '*)
            artifact_digest=${output_line##*: }
            ;;
    esac
done <<<"${dark_host_preflight_output}"
if [[ ! ${artifact_digest} =~ ^[0-9a-f]{64}$ ]]; then
    echo "The M3.5 preflight did not report one valid artifact digest." >&2
    exit 1
fi

ssh \
    -o BatchMode=yes \
    -o IdentitiesOnly=yes \
    -o StrictHostKeyChecking=yes \
    -i "${ANSIBLE_PRIVATE_KEY_FILE}" \
    ldp-admin@lowerduckpond.net \
    "sudo --non-interactive /bin/bash -s -- ${artifact_digest}" <<'REMOTE'
set -euo pipefail
export LC_ALL=C

candidate_artifact_digest=$1
previous_artifact_digest=ed1c2a95f1aa7b17dcd949c0efb5f815af59e6fae46e0edf3a1f08e3ea4da357

remote_fail() {
    printf 'M3.6 production preflight failed: %s\n' "$1" >&2
    exit 1
}

publication_configuration=/etc/lowerduckpond/static-publication.json
[[ -f ${publication_configuration} && ! -L ${publication_configuration} ]] ||
    remote_fail "the publication gate configuration has an unexpected type"
[[ $(stat --format='%U:%G:%a:%s' -- "${publication_configuration}") == \
    root:root:400:89 ]] ||
    remote_fail "the publication gate configuration metadata drifted"
[[ $(<"${publication_configuration}") == \
    '{"format":"lowerduckpond-static-publication-gate-v1","static_publication_enabled":false}' ]] ||
    remote_fail "static publication is not exactly disabled"

set +e
gate_output=$(
    /usr/local/libexec/lowerduckpond/static-publication-gate job-issuance 2>&1
)
gate_status=$?
set -e
[[ ${gate_status} -eq 78 ]] ||
    remote_fail "job issuance did not return the disabled status"
[[ ${gate_output} == publication_disabled ]] ||
    remote_fail "job issuance did not return the disabled reason"

install_root=/opt/lowerduckpond/static-host-agent
[[ -L ${install_root}/current ]] ||
    remote_fail "the selected host-agent artifact is not a symbolic link"
selected_artifact=$(readlink --canonicalize-existing -- "${install_root}/current") ||
    remote_fail "the selected host-agent artifact cannot be resolved"
selected_artifact_digest=${selected_artifact##*/}
[[ ${selected_artifact} == "${install_root}/${selected_artifact_digest}" ]] ||
    remote_fail "the selected host-agent artifact escaped its install root"
if [[ ${selected_artifact_digest} != "${previous_artifact_digest}" &&
      ${selected_artifact_digest} != "${candidate_artifact_digest}" ]]; then
    remote_fail "the selected host-agent artifact has an unexpected identity"
fi
/usr/local/libexec/lowerduckpond/verify-static-host-agent-artifact \
    "${selected_artifact}" >/dev/null ||
    remote_fail "the selected M3.5 host-agent artifact is invalid"

state_root=/var/lib/lowerduckpond/static
[[ -d ${state_root} && ! -L ${state_root} ]] ||
    remote_fail "the authoritative state root has an unexpected type"
[[ $(stat --format='%U:%G:%a' -- "${state_root}") == root:root:700 ]] ||
    remote_fail "the authoritative state root metadata drifted"
expected_state_inventory=$'audit\nauthorization\nexports\nintake\nintents\nlocks\nplatform\ntenants'
actual_state_inventory=$(find "${state_root}" -mindepth 1 -maxdepth 1 -printf '%f\n' | sort)
[[ ${actual_state_inventory} == "${expected_state_inventory}" ]] ||
    remote_fail "the authoritative state-root inventory drifted"

authorization_root=${state_root}/authorization
expected_authorization_inventory=$'correlations\njobs\nresults'
actual_authorization_inventory=$(
    find "${authorization_root}" -mindepth 1 -maxdepth 1 -printf '%f\n' | sort
)
[[ ${actual_authorization_inventory} == "${expected_authorization_inventory}" ]] ||
    remote_fail "the authorization inventory drifted"

empty_directory_contracts=(
    /var/lib/lowerduckpond/static/platform\|root:root:700
    /var/lib/lowerduckpond/static/tenants\|root:root:700
    /var/lib/lowerduckpond/static/authorization/jobs\|root:root:700
    /var/lib/lowerduckpond/static/authorization/results\|root:root:700
    /var/lib/lowerduckpond/static/authorization/correlations\|root:root:700
    /var/lib/lowerduckpond/static/intents\|root:root:700
    /var/lib/lowerduckpond/static/intake\|root:root:700
    /var/lib/lowerduckpond/static/exports\|root:root:700
    /var/lib/lowerduckpond/static/audit\|root:root:700
    /srv/lowerduckpond/sites\|root:caddy:710
)
for contract in "${empty_directory_contracts[@]}"; do
    path=${contract%%|*}
    expected_metadata=${contract#*|}
    [[ -d ${path} && ! -L ${path} ]] ||
        remote_fail "${path} has an unexpected type"
    [[ $(stat --format='%U:%G:%a' -- "${path}") == "${expected_metadata}" ]] ||
        remote_fail "${path} metadata drifted"
    [[ -z $(find "${path}" -mindepth 1 -print -quit) ]] ||
        remote_fail "${path} is not empty"
done

caddy_intent_root=/etc/caddy/intents
[[ -d ${caddy_intent_root} && ! -L ${caddy_intent_root} ]] ||
    remote_fail "${caddy_intent_root} has an unexpected type"
[[ $(stat --format='%U:%G:%a' -- "${caddy_intent_root}") == root:root:700 ]] ||
    remote_fail "${caddy_intent_root} metadata drifted"
caddy_intent_inventory=$(
    find "${caddy_intent_root}" -mindepth 1 -maxdepth 1 -printf '%f\n' | sort
)
if [[ -n ${caddy_intent_inventory} ]]; then
    [[ ${caddy_intent_inventory} == start.json ]] ||
        remote_fail "the Caddy startup-intent inventory is not resumable"
    [[ $(stat --format='%F:%U:%G:%a:%h' -- \
        "${caddy_intent_root}/start.json") == \
        regular\ file:root:root:600:1 ]] ||
        remote_fail "the Caddy startup intent metadata drifted"
fi

generation_root=/etc/caddy/generations
[[ -d ${generation_root} && ! -L ${generation_root} ]] ||
    remote_fail "${generation_root} has an unexpected type"
[[ $(stat --format='%U:%G:%a' -- "${generation_root}") == root:caddy:750 ]] ||
    remote_fail "${generation_root} metadata drifted"
if [[ -n $(find "${generation_root}" -mindepth 1 -print -quit) ]]; then
    generation_check=/usr/local/libexec/lowerduckpond/check-caddy-generation
    [[ -f ${generation_check} && ! -L ${generation_check} ]] ||
        remote_fail "the immutable Caddy generation check is absent"
    [[ $(stat --format='%U:%G:%a' -- "${generation_check}") == root:root:755 ]] ||
        remote_fail "the immutable Caddy generation check metadata drifted"
    generation_status=$("${generation_check}") ||
        remote_fail "the immutable Caddy generation check failed"
    case ${generation_status} in
        unchanged)
            [[ -z ${caddy_intent_inventory} ]] ||
                remote_fail "a current Caddy generation retains a startup intent"
            ;;
        pending)
            [[ ${caddy_intent_inventory} == start.json ]] ||
                remote_fail "the pending Caddy transaction has no durable intent"
            ;;
        *) remote_fail "the selected immutable Caddy generation is not current" ;;
    esac
elif [[ -n ${caddy_intent_inventory} ]]; then
    remote_fail "a Caddy startup intent exists without a generation"
fi

state_parent_directories=(
    /var/lib/lowerduckpond/static/authorization
    /var/lib/lowerduckpond/static/locks
)
for path in "${state_parent_directories[@]}"; do
    [[ -d ${path} && ! -L ${path} ]] ||
        remote_fail "${path} has an unexpected type"
    [[ $(stat --format='%U:%G:%a' -- "${path}") == root:root:700 ]] ||
        remote_fail "${path} metadata drifted"
done

locks=${state_root}/locks
actual_locks=$(find "${locks}" -mindepth 1 -maxdepth 1 -printf '%f\n' | sort)
while IFS= read -r lock; do
    [[ -n ${lock} ]] || continue
    case ${lock} in
        export.lock | intake.lock | publication.lock | tenant-state.lock) ;;
        *) remote_fail "the static lock inventory contains ${lock}" ;;
    esac
    [[ $(stat --format='%F:%U:%G:%a:%h:%s' -- "${locks}/${lock}") == \
        regular\ file:root:root:600:1:0 ]] ||
        remote_fail "${lock} metadata drifted"
done <<<"${actual_locks}"

worker_units=$(systemctl list-units --all --plain --no-legend \
    'lowerduckpond-static-worker@*.service')
if [[ -n ${worker_units} ]]; then
    remote_fail "a static authorization worker already exists"
fi
REMOTE

printf 'M3.6 production preflight passed without changing host state.\n'
printf 'Static publication remains disabled and authoritative state is empty.\n'
