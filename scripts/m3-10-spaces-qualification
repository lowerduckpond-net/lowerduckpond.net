#!/usr/bin/env bash
# Run only on the secure workstation. This never connects to the production host.
set +x
set -euo pipefail
umask 077
# Local fixture ownership cannot alter this serialized live workflow.
unset LDP_QUALIFICATION_RUN_ID LDP_QUALIFICATION_HOST LDP_QUALIFICATION_ARCHIVE
unset LDP_QUALIFICATION_IMAGE LDP_QUALIFICATION_SSH_PORT LDP_QUALIFICATION_ARTIFACT
unset MOLECULE_EPHEMERAL_DIRECTORY

repository_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "${repository_root}"
if (($#)); then
    echo "Usage: $0" >&2
    exit 2
fi
for variable_name in SPACES_ACCESS_KEY_ID SPACES_SECRET_ACCESS_KEY; do
    if [[ -z ${!variable_name:-} ]]; then
        echo "Required environment variable ${variable_name} is not set." >&2
        exit 2
    fi
done
for command_name in docker git jq tofu uv; do
    command -v "${command_name}" >/dev/null || {
        echo "Required command ${command_name} is unavailable." >&2
        exit 2
    }
done
if [[ -n $(git status --porcelain) ]]; then
    echo "Live M3.10 qualification requires a clean source revision." >&2
    exit 2
fi
# A remote daemon would copy the live archive credential off the workstation.
if [[ -n ${DOCKER_CONTEXT:-} ]]; then
    docker_endpoint=$(docker context inspect "${DOCKER_CONTEXT}" --format '{{.Endpoints.docker.Host}}')
else
    docker_endpoint=${DOCKER_HOST:-$(docker context inspect --format '{{.Endpoints.docker.Host}}')}
fi
if [[ ${docker_endpoint} != unix:///* ]]; then
    echo "Live M3.10 qualification requires a local Unix-socket Docker daemon." >&2
    exit 2
fi
# Pin both the CLI and Python Docker clients to the checked endpoint.
unset DOCKER_CONTEXT
export DOCKER_HOST="${docker_endpoint}"
docker info >/dev/null
for container in lowerduckpond-ubuntu-2604 lowerduckpond-m3-10-minio; do
    if docker inspect "${container}" >/dev/null 2>&1; then
        echo "A qualification container already exists; preserve it and resolve its run first." >&2
        exit 2
    fi
done

source_revision=$(git rev-parse HEAD)
evidence_root=${M3_10_EVIDENCE_ROOT:-${XDG_DATA_HOME:-${HOME}/.local/share}/lowerduckpond.net/m3-10}
mkdir -p -- "${evidence_root}"
chmod 0700 "${evidence_root}"
run_directory=$(mktemp -d "${evidence_root}/spaces-${source_revision:0:7}.XXXXXX")
run_directory=$(cd -- "${run_directory}" && pwd -P)
printf 'Private M3.10 qualification run: %s\n' "${run_directory}"
printf '%s\n' "${source_revision}" >"${run_directory}/source-revision"
failed() {
    local status=$?
    uv run --quiet --no-sync --frozen python "${repository_root}/scripts/qualification_timing.py" \
        finish "${run_directory}" --status "${status}" || true
    if ((status != 0)); then
        uv run --quiet --no-sync --frozen python "${repository_root}/scripts/qualification_failure.py" \
            collect "${run_directory}" --status "${status}" --phase "${diagnostic_phase}" || true
        printf 'Qualification failed; no passing report was created.\n' >&2
        printf 'Private run logs: %s\n' "${run_directory}" >&2
    fi
}
diagnostic_phase=state-inputs
trap failed EXIT
export LDP_QUALIFICATION_TIMING_EVENTS="${run_directory}/timing-events.jsonl"
export LDP_QUALIFICATION_TIMING_GROUP=unclassified
export ANSIBLE_CALLBACK_PLUGINS="${repository_root}/config/ansible/plugins/callback"
export ANSIBLE_CALLBACKS_ENABLED=ldp_timing
# The stdlib-only reporter must not install dependencies before the logged sync.
uv run --quiet --no-sync --frozen python "${repository_root}/scripts/qualification_timing.py" \
    start "${run_directory}" --backend spaces || true

# State access and every provider secret stay in this process tree. Logs are
# private operator diagnostics, not sanitized reports or uploadable artifacts.
source "${repository_root}/scripts/lib/m3-10-production-state"
diagnostic_phase=dependencies
uv sync --all-packages --all-groups --frozen >"${run_directory}/dependencies.log" 2>&1
uv run --quiet --frozen python -m scripts.qualification_minio \
    >"${run_directory}/local-storage-fixture.log" 2>&1
diagnostic_phase=state-inputs
uv run --quiet --frozen python -m scripts.production_qualification_inputs \
    --capture-run "${run_directory}" --source "${source_revision}"
diagnostic_phase=provider-preflight
uv run --quiet --frozen python -m scripts.check_m3_10_provider --storage-only
diagnostic_phase=storage-acceptance
uv run --quiet --frozen ldp-m3-archive acceptance \
    --backup-bucket "${SPACES_BACKUP_BUCKET}" --archive-bucket "${SPACES_ARCHIVE_BUCKET}" \
    --source-revision "${source_revision}" --region "${SPACES_REGION}" \
    --output "${run_directory}/storage.json" >"${run_directory}/storage.log" 2>&1
uv run --quiet --frozen ldp-m3-archive verify-report "${run_directory}/storage.json"

export M3_10_ARCHIVE_BACKEND=spaces
export M3_10_INSTALLED_REPORT="${run_directory}/installed.json"
export M3_8_STATIC_PUBLICATION_ENABLED=false
unset M3_8_CLOUDFLARE_API_TOKEN
export ANSIBLE_CONFIG="${repository_root}/config/ansible/ansible.cfg"
# Live values are attached using no_log add_host and installed using the normal
# no_log role. Inventory, generated artifacts, and fixtures contain no secrets.
cd "${repository_root}/config/ansible"
for phase in create prepare converge idempotence verify; do
    diagnostic_phase=${phase}
    printf 'M3.10 installed Spaces qualification: %s\n' "${phase}"
    uv run --frozen molecule "${phase}" --scenario-name m3_8 \
        >"${run_directory}/${phase}.log" 2>&1
    printf '%s\n' passed >"${run_directory}/${phase}.passed"
    if [[ ${phase} == create ]]; then
        uv run --quiet --no-sync --frozen python "${repository_root}/scripts/qualification_failure.py" fixture || true
    fi
done
cd "${repository_root}"
# Record the start of the final independent proof conservatively, so pausing
# before report packaging cannot refresh evidence that was already collected.
diagnostic_phase=final-storage-proof
date --utc +%Y-%m-%dT%H:%M:%S.%NZ >"${run_directory}/final-proof.started-at"
uv run --quiet --frozen python -m scripts.check_m3_10_provider --storage-only
if [[ $(git rev-parse HEAD) != "${source_revision}" || -n $(git status --porcelain) ]]; then
    echo "Source changed during live qualification; preserve this run for investigation." >&2
    exit 1
fi
artifact_digest=$(sha256sum /tmp/lowerduckpond-static-host-agent-m3-8.tar)
artifact_digest=${artifact_digest%% *}
if [[ $(jq --exit-status --raw-output '.artifact_sha256' "${M3_10_INSTALLED_REPORT}") != "${artifact_digest}" ]]; then
    echo "The installed artifact differs from the built qualification artifact." >&2
    exit 1
fi

# Only a completed lifecycle and an independent empty-bucket proof permit
# destruction. Failures retain the host that owns any remaining remote bytes.
cd "${repository_root}/config/ansible"
diagnostic_phase=destroy
uv run --frozen molecule destroy --scenario-name m3_8 >"${run_directory}/destroy.log" 2>&1
printf '%s\n' passed >"${run_directory}/destroy.passed"
cd "${repository_root}"
diagnostic_phase=package
uv run --quiet --frozen python -m scripts.m3_10_qualification_report "${run_directory}"
printf 'Share only qualification.json and qualification.sha256 from %s.\n' "${run_directory}"
