#!/usr/bin/env bash
# Read-only initial M3.11 production gate, on the secure workstation only.
set +x
set -euo pipefail
umask 077

repository_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "${repository_root}"
if (($#)); then
    echo "Usage: $0" >&2
    exit 2
fi
required_environment=(
    ADMIN_SOURCE_CIDRS_JSON
    ANSIBLE_PRIVATE_KEY_FILE STATIC_OPERATOR_PRINCIPAL STATIC_OPERATOR_PUBLIC_KEY
    SPACES_ACCESS_KEY_ID SPACES_SECRET_ACCESS_KEY CLOUDFLARE_API_TOKEN
    CADDY_CLOUDFLARE_API_TOKEN M3_10_TOKEN_AUDIT_TOKEN M3_10_PAGE_RULES_TOKEN
    CLOUDFLARE_ZONE_ID CLOUDFLARE_TENANT_ZONE_ID
    CLOUDFLARE_ORIGIN_PULL_CERTIFICATE_ID CLOUDFLARE_TENANT_ORIGIN_PULL_CERTIFICATE_ID
)
for variable_name in "${required_environment[@]}"; do
    if [[ -z ${!variable_name:-} ]]; then
        echo "Required environment variable ${variable_name} is not set." >&2
        exit 2
    fi
done
git fetch --quiet origin main
if [[ $(git branch --show-current) != main || -n $(git status --porcelain) ||
      $(git rev-parse HEAD) != "$(git rev-parse origin/main)" ]]; then
    echo "M3.11 production preflight requires clean, current main." >&2
    exit 2
fi
source "${repository_root}/scripts/lib/m3-10-production-state"
exec uv run --quiet --frozen python -m scripts.m3_11_production_preflight
