#!/usr/bin/env bash
set -euo pipefail

readonly repository_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
readonly caddyfile="${repository_root}/tools/m3-qualification/local/Caddyfile"
readonly playwright_image='mcr.microsoft.com/playwright:v1.62.0-noble@sha256:baed2032d533817f3dbe6425de795788430ba345e819a1201337009ba17c9d07'
readonly caddy_image='caddy:2.11.4@sha256:df7f1c2fb114453b951de51a98efc010db1655a92c2e86be6706714e2417a78d'
readonly suffix=$$
readonly network="ldp-m3-browser-${suffix}"
readonly caddy_container="ldp-m3-caddy-${suffix}"
readonly browser_container="ldp-m3-playwright-${suffix}"
readonly tunnel_connection="${repository_root}/scripts/m3-docker-exec-tcp-connection"
docker_endpoint=${DOCKER_HOST:-$(docker context inspect --format '{{.Endpoints.docker.Host}}')}
readonly docker_endpoint
publish_arguments=()
if [[ $docker_endpoint == unix://* || $docker_endpoint == npipe://* ]]; then
    publish_arguments=(--publish 127.0.0.1::3000)
fi
temporary_root=$(mktemp -d "${TMPDIR:-/tmp}/ldp-m3-browser.XXXXXXXX")
readonly temporary_root
proxy_pid=

cleanup() {
    if [[ -n $proxy_pid ]]; then
        kill "$proxy_pid" >/dev/null 2>&1 || true
        wait "$proxy_pid" 2>/dev/null || true
    fi
    docker rm --force -- "$browser_container" "$caddy_container" >/dev/null 2>&1 || true
    docker network rm -- "$network" >/dev/null 2>&1 || true
    rm -r -- "$temporary_root"
}
trap cleanup EXIT

docker network create -- "$network" >/dev/null
docker create \
    --name "$caddy_container" \
    --network "$network" \
    --network-alias platform.ldp-platform.test \
    --network-alias alias.ldp-tenant.test \
    --network-alias t-0198d17f6f4a70008000000000000001.ldp-tenant.test \
    --network-alias unknown.ldp-tenant.test \
    "$caddy_image" >/dev/null
docker cp -- "$caddyfile" "$caddy_container:/etc/caddy/Caddyfile"
docker start "$caddy_container" >/dev/null

docker run --detach --rm \
    --name "$browser_container" \
    --network "$network" \
    "${publish_arguments[@]}" \
    "$playwright_image" \
    /bin/sh -c 'npx --yes playwright@1.62.0 run-server --port 3000 --host 0.0.0.0' >/dev/null

for _ in {1..100}; do
    if ! docker inspect --format '{{.State.Running}}' "$caddy_container" | grep -qx true; then
        docker logs "$caddy_container" >&2
        exit 1
    fi
    if docker logs "$browser_container" 2>&1 | grep -q 'Listening on ws://'; then
        break
    fi
    sleep 0.1
done
if ! docker logs "$browser_container" 2>&1 | grep -q 'Listening on ws://'; then
    docker logs "$browser_container" >&2
    exit 1
fi

if ((${#publish_arguments[@]})); then
    endpoint_port=$(docker inspect \
        --format '{{(index (index .NetworkSettings.Ports "3000/tcp") 0).HostPort}}' \
        "$browser_container")
else
    if [[ $(docker inspect --format '{{len .HostConfig.PortBindings}}' "$browser_container") -ne 0 ]]; then
        echo "remote browser container unexpectedly publishes a host port" >&2
        exit 1
    fi
    endpoint_port=$(uv run python -c \
        'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')
    socat "TCP-LISTEN:${endpoint_port},bind=127.0.0.1,reuseaddr,fork" \
        "EXEC:${tunnel_connection} ${browser_container} 3000,nofork" 2>/dev/null &
    proxy_pid=$!
fi
readonly endpoint_port
for _ in {1..100}; do
    if (exec 8<>"/dev/tcp/127.0.0.1/${endpoint_port}") 2>/dev/null; then
        exec 8>&-
        break
    fi
    sleep 0.1
done
if ! (exec 8<>"/dev/tcp/127.0.0.1/${endpoint_port}") 2>/dev/null; then
    exit 1
fi
exec 8>&-

set +e
uv run ldp-m3-qualify browser \
    --run-id 0198d17f-6f4a-7000-8000-000000000001 \
    --source-revision 0000000000000000000000000000000000000000 \
    --platform-origin https://platform.ldp-platform.test \
    --tenant-alias-origin https://alias.ldp-tenant.test \
    --tenant-immutable-origin https://t-0198d17f6f4a70008000000000000001.ldp-tenant.test \
    --tenant-unknown-origin https://unknown.ldp-tenant.test \
    --ws-endpoint "ws://127.0.0.1:${endpoint_port}/" \
    --ignore-https-errors \
    --output "$temporary_root/browser.json"
qualification_status=$?
set -e
if [[ -f $temporary_root/browser.json && $qualification_status -ne 0 ]]; then
    jq --raw-output '.checks[] | "\(.check_id): \(.status)"' \
        "$temporary_root/browser.json" >&2
fi
exit "$qualification_status"
