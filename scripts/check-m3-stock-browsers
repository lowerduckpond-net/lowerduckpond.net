#!/usr/bin/env bash
set -euo pipefail

readonly repository_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
readonly caddyfile="${repository_root}/tools/m3-qualification/local/Caddyfile"
readonly caddy_image='caddy:2.11.4@sha256:df7f1c2fb114453b951de51a98efc010db1655a92c2e86be6706714e2417a78d'
readonly selenium_release=4.46.0-20260707
readonly firefox_image="selenium/standalone-firefox:${selenium_release}@sha256:68754beb3956735905fe9a49004d71c3e1de7b410885151fd8f139618e9537dc"
readonly chrome_image="selenium/standalone-chrome:${selenium_release}@sha256:9569014786466376d3e5cf8a7758562368cd9637f783dcd3abdb2eaf3a0d5cd7"
readonly suffix=$$
readonly network="ldp-m3-stock-${suffix}"
readonly caddy_container="ldp-m3-stock-caddy-${suffix}"
docker_endpoint=$(docker context inspect --format '{{.Endpoints.docker.Host}}')
readonly docker_endpoint
if [[ $docker_endpoint == tcp://* ]]; then
    readonly publish_spec=::4444
    daemon_host=$(sed -E 's#^[a-z]+://([^:/]+).*#\1#' <<< "$docker_endpoint")
else
    readonly publish_spec=127.0.0.1::4444
    daemon_host=127.0.0.1
fi
browser_container=
proxy_pid=

cleanup_browser() {
    if [[ -n $proxy_pid ]]; then
        kill "$proxy_pid" >/dev/null 2>&1 || true
        wait "$proxy_pid" 2>/dev/null || true
        proxy_pid=
    fi
    if [[ -n $browser_container ]]; then
        docker rm --force -- "$browser_container" >/dev/null 2>&1 || true
        browser_container=
    fi
}

cleanup() {
    cleanup_browser
    docker rm --force -- "$caddy_container" >/dev/null 2>&1 || true
    docker network rm -- "$network" >/dev/null 2>&1 || true
}
trap cleanup EXIT

docker network create -- "$network" >/dev/null
docker create \
    --name "$caddy_container" \
    --network "$network" \
    --network-alias platform.ldp-platform.test \
    --network-alias alias.ldp-tenant.test \
    --network-alias t-0198d17f6f4a70008000000000000001.ldp-tenant.test \
    --network-alias unknown.ldp-tenant.test \
    "$caddy_image" >/dev/null
docker cp -- "$caddyfile" "$caddy_container:/etc/caddy/Caddyfile"
docker start "$caddy_container" >/dev/null

for browser in firefox chrome; do
    browser_container="ldp-m3-stock-${browser}-${suffix}"
    if [[ $browser == firefox ]]; then
        browser_image=$firefox_image
    else
        browser_image=$chrome_image
    fi
    docker run --detach --rm \
        --name "$browser_container" \
        --network "$network" \
        --publish "$publish_spec" \
        --shm-size 2g \
        "$browser_image" >/dev/null
    webdriver_port=$(docker inspect \
        --format '{{(index (index .NetworkSettings.Ports "4444/tcp") 0).HostPort}}' \
        "$browser_container")
    endpoint_port=$webdriver_port
    if [[ $docker_endpoint == tcp://* ]]; then
        endpoint_port=$(uv run python -c \
            'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')
        socat "TCP-LISTEN:${endpoint_port},bind=127.0.0.1,reuseaddr,fork" \
            "TCP:${daemon_host}:${webdriver_port}" 2>/dev/null &
        proxy_pid=$!
    fi
    for _ in {1..300}; do
        if curl --silent --fail "http://127.0.0.1:${endpoint_port}/status" >/dev/null 2>&1; then
            break
        fi
        sleep 0.1
    done
    curl --silent --fail "http://127.0.0.1:${endpoint_port}/status" >/dev/null
    uv run python tools/m3-qualification/local/check_webdriver.py \
        --endpoint "http://127.0.0.1:${endpoint_port}" \
        --browser "$browser"
    cleanup_browser
done
