[Unit]
Description=Lower Duck Pond M3 qualification Caddy
After=network-online.target ldp-m3-fixture.service
Wants=network-online.target
Requires=ldp-m3-fixture.service
StartLimitIntervalSec=30s
StartLimitBurst=3

[Service]
Type=notify
User=caddy
Group=caddy
EnvironmentFile=/etc/caddy/environment
Environment=XDG_CONFIG_HOME=/etc/caddy
Environment=XDG_DATA_HOME=/var/lib/caddy
RuntimeDirectory=caddy lowerduckpond-m3-qualification
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStartPre=/usr/local/libexec/lowerduckpond/m3-caddy-hook start-pre
ExecStart=/usr/local/libexec/lowerduckpond/m3-caddy-generation run
ExecStartPost=/usr/local/libexec/lowerduckpond/m3-caddy-hook start-post
ExecReload=/usr/local/libexec/lowerduckpond/m3-caddy-hook reload-pre
ExecReload=/usr/local/libexec/lowerduckpond/m3-caddy-generation reload
ExecReload=/usr/local/libexec/lowerduckpond/m3-caddy-hook reload-post
Restart=on-failure
RestartSec=250ms
TimeoutStartSec=2min
TimeoutStopSec=5s
LimitNOFILE=1048576
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ReadOnlyPaths={{ m3_qualification_generation_root }} {{ m3_qualification_static_root }}
ReadWritePaths=/var/lib/caddy /var/log/caddy {{ m3_qualification_runtime_root }}
UMask=0077

[Install]
WantedBy=multi-user.target
