#!/usr/bin/python3 -I
from __future__ import annotations

import json
import os
import pathlib
import re
import stat
import subprocess
import sys

sys.dont_write_bytecode = True

CONFIGURATION = pathlib.Path("/etc/lowerduckpond/static-publication.json")
EXPECTED_KEYS = {"format", "static_publication_enabled"}
PROTECTED_FILE_MODE = 0o400
INSTALLATION = pathlib.Path("/opt/lowerduckpond/static-host-agent/current/site-packages")
STATE = pathlib.Path("/var/lib/lowerduckpond/static")
SUCCESSOR = pathlib.Path("/var/lib/lowerduckpond/convergence/m3-12")
WORKER_CREDENTIALS = pathlib.Path("/run/credentials")
TWO_ARGUMENTS = 2
UUIDV7 = re.compile(
    r"[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}",
    flags=re.ASCII,
)


def fail(message: str, status: int = 1) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(status)


def publication_enabled() -> bool:
    metadata = CONFIGURATION.lstat()
    if (
        not stat.S_ISREG(metadata.st_mode)
        or stat.S_IMODE(metadata.st_mode) != PROTECTED_FILE_MODE
        or metadata.st_uid != 0
        or metadata.st_gid != 0
        or metadata.st_nlink != 1
    ):
        fail("static publication configuration is not protected")
    try:
        payload = json.loads(CONFIGURATION.read_bytes())
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        fail(f"static publication configuration is invalid: {type(error).__name__}")
    if (
        not isinstance(payload, dict)
        or set(payload) != EXPECTED_KEYS
        or payload["format"] != "lowerduckpond-static-publication-gate-v1"
        or not isinstance(payload["static_publication_enabled"], bool)
    ):
        fail("static publication configuration has an invalid shape")
    return payload["static_publication_enabled"]


def require_restore_admission() -> None:
    admitted = subprocess.run(
        ["/usr/local/libexec/lowerduckpond/host-restore-gate", "--ordinary"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
        timeout=30,
    )
    if admitted.returncode != 0:
        fail("host_restore_pending", 78)


def require_successor_launch(boot_path: pathlib.Path | None) -> None:
    if not os.path.lexists(SUCCESSOR) and not os.path.lexists(STATE / "platform/launch.json"):
        return
    sys.path.insert(0, str(INSTALLATION))
    try:
        from lowerduckpond_static_host_agent.droplet_enrollment import (  # noqa: PLC0415
            PUBLICATION_VIEW,
        )
        from lowerduckpond_static_host_agent.platform_launch import (  # noqa: PLC0415
            require_local_launch_binding,
            verify_launch,
        )
        from lowerduckpond_static_host_agent.successor_rollback import (  # noqa: PLC0415
            require_unfenced_publication,
        )

        require_unfenced_publication(SUCCESSOR)
        droplet = SUCCESSOR / PUBLICATION_VIEW
        authority = droplet if os.path.lexists(droplet) else SUCCESSOR
        receipt = verify_launch(STATE, authority)
        disposable = os.path.lexists("/.dockerenv")
        if authority == droplet and boot_path is not None:
            require_local_launch_binding(
                authority, receipt, disposable=disposable, boot_path=boot_path
            )
        else:
            require_local_launch_binding(authority, receipt, disposable=disposable)
    except Exception:
        fail("launch_authority_unavailable", 78)


def main() -> None:
    require_restore_admission()
    arguments = sys.argv[1:]
    boot_path = None
    if arguments == ["job-issuance"]:
        pass
    elif (
        len(arguments) == TWO_ARGUMENTS
        and arguments[0] == "caddy-generation"
        and arguments[1].isascii()
        and arguments[1].isdigit()
    ):
        if int(arguments[1]) == 0 and not publication_enabled():
            return
    elif (
        len(arguments) == TWO_ARGUMENTS
        and arguments[0] == "worker"
        and UUIDV7.fullmatch(arguments[1]) is not None
    ):
        boot_path = (
            WORKER_CREDENTIALS
            / f"lowerduckpond-static-worker@{arguments[1]}.service"
            / "lowerduckpond-boot-id"
        )
    else:
        fail("invalid static publication gate invocation", 64)

    if not publication_enabled():
        fail("publication_disabled", 78)
    require_successor_launch(boot_path)


if __name__ == "__main__":
    main()
