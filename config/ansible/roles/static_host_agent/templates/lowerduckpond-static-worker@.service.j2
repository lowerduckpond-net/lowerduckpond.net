[Unit]
Description=Lower Duck Pond dark static worker %i
ConditionPathIsReadWrite={{ static_host_agent_state_root }}

[Service]
Type=exec
UMask=0077
ExecStart=/usr/local/libexec/lowerduckpond/static-publication-gate worker %i
MemoryMax=256M
MemorySwapMax=0
TasksMax=32
LimitNOFILE=1024
LimitCPU=120
LimitCORE=0
RuntimeMaxSec=5min
TimeoutStartSec=5min
CPUQuota=100%
StandardInput=null
StandardOutput=null
StandardError=null
PrivateIPC=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
TemporaryFileSystem=/:ro
TemporaryFileSystem=/workspace:rw,size=64M,nr_inodes=4096,mode=0700
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
InaccessiblePaths=/proc
InaccessiblePaths=/dev/tty
InaccessiblePaths=/dev/ptmx
InaccessiblePaths=/dev/pts
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=~AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@network-io
SystemCallFilter=~@keyring
SystemCallFilter=~@resources
SystemCallFilter=~prlimit64
SystemCallFilter=~sync syncfs
SystemCallFilter=~inotify_init inotify_init1 inotify_add_watch
SystemCallFilter=~pipe pipe2 mknod mknodat ioctl
SystemCallFilter=~timer_create
SystemCallFilter=~io_uring_setup io_uring_register io_uring_enter
SystemCallFilter=~clone clone3 fork vfork
SystemCallFilter=~kill tkill tgkill rt_sigqueueinfo rt_tgsigqueueinfo pidfd_send_signal
SystemCallFilter=~ptrace process_vm_readv process_vm_writev pidfd_getfd process_madvise process_mrelease
SystemCallErrorNumber=EPERM
DevicePolicy=closed
IPAddressDeny=any
TimeoutStopSec=15s
KillMode=mixed
