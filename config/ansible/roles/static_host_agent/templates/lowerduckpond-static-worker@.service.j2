[Unit]
Description=Lower Duck Pond authorized static worker %i
ConditionPathIsReadWrite={{ static_host_agent_state_root }}
OnSuccess=lowerduckpond-static-reconcile.service

[Service]
Type=exec
User={{ provisioner_user }}
Group={{ provisioner_group }}
Slice=lowerduckpond-static-workers.slice
UMask=0077
ExecStart=/usr/bin/sudo --non-interactive --user=root --group=caddy {{ static_host_agent_executor }} %i
MemoryMax=256M
MemorySwapMax=0
TasksMax=32
LimitNOFILE=1024
LimitCPU=120
LimitCORE=0
RuntimeMaxSec=5min
TimeoutStartSec=5min
CPUQuota=100%
StandardInput=null
StandardOutput=null
StandardError=null
PrivateIPC=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
TemporaryFileSystem=/:ro
TemporaryFileSystem=/workspace:rw,size=64M,nr_inodes=4096,mode=0700
BindReadOnlyPaths=/usr
BindReadOnlyPaths=/lib
BindReadOnlyPaths=/lib64
BindReadOnlyPaths=/etc/group
BindReadOnlyPaths=/etc/login.defs
BindReadOnlyPaths=/etc/nsswitch.conf
BindReadOnlyPaths=/etc/pam.d
BindReadOnlyPaths=/etc/passwd
BindReadOnlyPaths=/etc/security
BindReadOnlyPaths=/etc/shadow
BindReadOnlyPaths=/etc/sudo.conf
BindReadOnlyPaths=/etc/sudoers
BindReadOnlyPaths=/etc/sudoers.d
BindReadOnlyPaths={{ static_host_agent_install_root }}
BindReadOnlyPaths=/etc/lowerduckpond/static-publication.json
BindPaths=/run/caddy
BindReadOnlyPaths=/run/systemd
BindPaths={{ static_host_agent_state_root }}
BindPaths=/etc/caddy
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
InaccessiblePaths=/dev/tty
InaccessiblePaths=/dev/ptmx
InaccessiblePaths=/dev/pts
NoNewPrivileges=false
CapabilityBoundingSet=CAP_CHOWN CAP_SETGID CAP_SETUID
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@keyring
SystemCallFilter=~sync syncfs
SystemCallFilter=~inotify_init inotify_init1 inotify_add_watch
SystemCallFilter=~mknod mknodat
SystemCallFilter=~timer_create
SystemCallFilter=~io_uring_setup io_uring_register io_uring_enter
SystemCallFilter=~kill tkill tgkill rt_sigqueueinfo rt_tgsigqueueinfo pidfd_send_signal
SystemCallFilter=~ptrace process_vm_readv process_vm_writev pidfd_getfd process_madvise process_mrelease
SystemCallErrorNumber=EPERM
DevicePolicy=closed
IPAddressDeny=any
TimeoutStopSec=15s
KillMode=mixed
