[Unit]
Description=Private Lower Duck Pond archive cleanup socket
After=local-fs.target

[Socket]
ListenStream=/run/lowerduckpond-archive/cleanup.sock
SocketUser=root
SocketGroup=root
SocketMode=0600
DirectoryMode=0700
# One fixed instance drains one connection; the next waits for service exit.
Accept=no
Service=lowerduckpond-archive-cleanup@request.service
FlushPending=no
Backlog=1
RemoveOnStop=true

[Install]
WantedBy=sockets.target
