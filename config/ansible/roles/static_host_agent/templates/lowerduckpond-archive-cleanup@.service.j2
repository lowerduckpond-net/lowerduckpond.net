[Unit]
Description=Lower Duck Pond archive cleanup network service
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/lowerduckpond/archive/credentials.json

[Service]
Type=exec
User=root
Group=root
UMask=0077
ExecStart=/usr/local/libexec/lowerduckpond/archive-cleanup-service
StandardInput=socket
StandardOutput=null
StandardError=journal
MemoryMax=128M
MemorySwapMax=0
TasksMax=16
LimitNOFILE=128
LimitCPU=120
LimitCORE=0
RuntimeMaxSec=5min
TimeoutStopSec=15s
CPUQuota=100%
PrivateIPC=true
PrivateDevices=true
# ProtectSystem=strict would mount the host root over the empty tmpfs root.
# The tmpfs root and each explicit read-only bind enforce filesystem isolation.
ProtectSystem=false
TemporaryFileSystem=/:ro
BindReadOnlyPaths=/usr
BindReadOnlyPaths=/lib
BindReadOnlyPaths=/lib64
BindReadOnlyPaths=/etc/ssl/certs
BindReadOnlyPaths=/etc/nsswitch.conf
BindReadOnlyPaths=/etc/hosts
BindReadOnlyPaths=/etc/resolv.conf
BindReadOnlyPaths=/etc/lowerduckpond/archive
BindReadOnlyPaths={{ static_host_agent_install_root }}
BindReadOnlyPaths={{ static_host_agent_state_root }}
BindPaths={{ static_host_agent_state_root }}/locks
BindReadOnlyPaths={{ static_host_agent_state_root }}/exports
BindPaths={{ static_host_agent_state_root }}/platform
BindPaths={{ static_host_agent_state_root }}/intents
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@keyring @resources
SystemCallErrorNumber=EPERM
