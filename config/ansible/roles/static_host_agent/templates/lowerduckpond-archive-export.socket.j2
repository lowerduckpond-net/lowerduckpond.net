[Unit]
Description=Private Lower Duck Pond archived export socket
After=local-fs.target

[Socket]
ListenStream=/run/lowerduckpond-archive/export.sock
SocketUser=root
SocketGroup=root
SocketMode=0600
DirectoryMode=0700
Accept=yes
MaxConnections=1
Backlog=1
RemoveOnStop=true

[Install]
WantedBy=sockets.target
