#!/usr/bin/env bash
set -euo pipefail
umask 077

status_directory=/var/lib/lowerduckpond/backup-status
staging_directory=/var/cache/lowerduckpond-backup/staging
lock_path=/var/cache/lowerduckpond-backup/repository.lock

record_status() {
    local status_name=$1
    local prior_status_name=$2
    local prior_timestamp
    local timestamp
    local temporary_status
    timestamp=$(date +%s)
    if [[ -s "${status_directory}/${prior_status_name}" ]]; then
        read -r prior_timestamp < "${status_directory}/${prior_status_name}"
        if [[ "${prior_timestamp}" =~ ^[0-9]+$ ]] &&
           (( timestamp <= prior_timestamp )); then
            timestamp=$((prior_timestamp + 1))
        fi
    fi
    temporary_status=$(mktemp "${status_directory}/.${status_name}.XXXXXXXX")
    printf '%s\n' "${timestamp}" > "${temporary_status}"
    chmod 0600 "${temporary_status}"
    mv --force --no-target-directory \
        "${temporary_status}" "${status_directory}/${status_name}"
}

finish() {
    result=$?
    rm -f "${staging_directory}/mariadb.sql.gz"
    if [[ ${result} -eq 0 ]]; then
        record_status backup-last-success backup-last-failure
    else
        record_status backup-last-failure backup-last-success
    fi
    exit "${result}"
}
trap finish EXIT

mkdir -p "${staging_directory}"
exec 9>"${lock_path}"
flock --exclusive 9

/usr/bin/env --ignore-environment PATH=/usr/bin:/bin \
    /usr/sbin/runuser --user {{ backup_database_service_user }} -- \
    /usr/bin/mariadb-dump --all-databases --single-transaction --quick \
    --routines --events --triggers | gzip --best > "${staging_directory}/mariadb.sql.gz"

set -a
# shellcheck disable=SC1091
source /etc/lowerduckpond/backup.env
set +a

restic backup \
    --host {{ backup_node_name | quote }} \
    --tag scheduled \
    /srv/lowerduckpond \
    /var/lib/caddy \
    /var/lib/lowerduckpond/manifests \
    /var/lib/lowerduckpond/audit \
    "${staging_directory}/mariadb.sql.gz"
