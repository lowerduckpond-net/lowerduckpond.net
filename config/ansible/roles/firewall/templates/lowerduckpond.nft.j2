#!/usr/sbin/nft -f

flush ruleset

table inet lowerduckpond {
{% set admin_ipv4 = firewall_admin_source_cidrs | reject('search', ':') | list %}
{% set admin_ipv6 = firewall_admin_source_cidrs | select('search', ':') | list %}
{% if admin_ipv4 | length > 0 %}
    set admin_ipv4 {
        type ipv4_addr
        flags interval
        elements = { {{ admin_ipv4 | join(', ') }} }
    }
{% endif %}
{% if admin_ipv6 | length > 0 %}
    set admin_ipv6 {
        type ipv6_addr
        flags interval
        elements = { {{ admin_ipv6 | join(', ') }} }
    }
{% endif %}

    chain input {
        type filter hook input priority filter; policy drop;
        iifname "lo" accept
        ct state established,related accept
        ct state invalid drop
        ip protocol icmp accept
        ip6 nexthdr ipv6-icmp accept
{% if admin_ipv4 | length > 0 %}
        ip saddr @admin_ipv4 tcp dport 22 ct state new accept
{% endif %}
{% if admin_ipv6 | length > 0 %}
        ip6 saddr @admin_ipv6 tcp dport 22 ct state new accept
{% endif %}
        tcp dport { 80, 443 } ct state new accept
    }

    chain forward {
        type filter hook forward priority filter; policy accept;
        ip daddr 169.254.169.254 reject
    }

    chain output {
        type filter hook output priority filter; policy accept;
        meta skuid != 0 ip daddr 169.254.169.254 reject
    }
}
