#!/usr/bin/env python3
"""Validate and converge one non-overlapping subordinate-ID allocation."""

from __future__ import annotations

import argparse
import fcntl
import os
import pathlib
import re
import stat
import tempfile
from dataclasses import dataclass


@dataclass(frozen=True)
class Allocation:
    owner: str
    start: int
    count: int

    @property
    def end(self) -> int:
        return self.start + self.count


def parse_allocation(line: str, line_number: int) -> Allocation | None:
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        return None
    fields = stripped.split(":")
    if len(fields) != 3:
        raise ValueError(f"line {line_number} is not a subordinate-ID allocation")
    owner, raw_start, raw_count = fields
    try:
        allocation = Allocation(owner, int(raw_start), int(raw_count))
    except ValueError as error:
        raise ValueError(f"line {line_number} contains a non-integer range") from error
    if allocation.start < 0 or allocation.count <= 0:
        raise ValueError(f"line {line_number} contains an invalid range")
    return allocation


def overlaps(left: Allocation, right: Allocation) -> bool:
    return left.start < right.end and right.start < left.end


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("path", type=pathlib.Path)
    parser.add_argument("owner")
    parser.add_argument("start", type=int)
    parser.add_argument("count", type=int)
    parser.add_argument("--check", action="store_true")
    arguments = parser.parse_args()

    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_-]*", arguments.owner):
        parser.error("owner is not a valid account name")
    desired = Allocation(arguments.owner, arguments.start, arguments.count)
    if desired.start < 0 or desired.count <= 0:
        parser.error("the requested range must have a non-negative start and positive count")
    if arguments.path.is_symlink():
        parser.error(f"refusing symbolic link: {arguments.path}")

    lock_path = pathlib.Path("/run/lock/lowerduckpond-subids.lock")
    with lock_path.open("a", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        metadata = arguments.path.stat()
        if not stat.S_ISREG(metadata.st_mode):
            parser.error(f"not a regular file: {arguments.path}")
        lines = arguments.path.read_text(encoding="utf-8").splitlines()
        allocations = [
            allocation
            for number, line in enumerate(lines, start=1)
            if (allocation := parse_allocation(line, number)) is not None
        ]

        for allocation in allocations:
            if allocation.owner != desired.owner and overlaps(allocation, desired):
                parser.error(
                    f"requested {desired.start}:{desired.count} range overlaps "
                    f"{allocation.owner}:{allocation.start}:{allocation.count}"
                )

        owned = [item for item in allocations if item.owner == desired.owner]
        if arguments.check:
            print("allocation is available")
            return 0
        if owned == [desired]:
            print("allocation is unchanged")
            return 0

        replacement = f"{desired.owner}:{desired.start}:{desired.count}"
        output_lines = []
        replaced = False
        for line in lines:
            if line.split(":", 1)[0] == desired.owner:
                if not replaced:
                    output_lines.append(replacement)
                    replaced = True
                continue
            output_lines.append(line)
        if not replaced:
            output_lines.append(replacement)

        temporary_name = None
        try:
            with tempfile.NamedTemporaryFile(
                "w",
                encoding="utf-8",
                dir=arguments.path.parent,
                prefix=f".{arguments.path.name}.",
                delete=False,
            ) as temporary:
                temporary_name = temporary.name
                os.fchmod(temporary.fileno(), stat.S_IMODE(metadata.st_mode))
                os.fchown(temporary.fileno(), metadata.st_uid, metadata.st_gid)
                temporary.write("\n".join(output_lines) + "\n")
                temporary.flush()
                os.fsync(temporary.fileno())
            os.replace(temporary_name, arguments.path)
        finally:
            if temporary_name is not None and os.path.exists(temporary_name):
                os.unlink(temporary_name)

    print("allocation was updated")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
