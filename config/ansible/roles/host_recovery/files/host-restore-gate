#!/usr/bin/python3 -I
"""A fixed root gate which works before the first artifact is installed."""

from __future__ import annotations

import fcntl
import os
import pathlib
import re
import stat
import subprocess
import sys
import time

sys.dont_write_bytecode = True
ROOT = pathlib.Path("/var/lib/lowerduckpond/recovery")
ARTIFACT_ROOT = pathlib.Path("/opt/lowerduckpond/static-host-agent")
PRIVATE_MODE = 0o700
LOCK_MODE = 0o600
MAX_UNINITIALIZED_ENTRIES = 64


def close_firewall() -> None:
    subprocess.run(
        ["/usr/sbin/nft", "--file", "/usr/local/share/lowerduckpond/restore-gate.nft"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env={"PATH": "/usr/bin:/bin"},
        check=True,
        timeout=10,
    )


def require_uninitialized_directory(root: pathlib.Path, *, owner: int = 0) -> None:
    """Accept only an empty lease and private unpublished atomic-write files."""
    with os.scandir(root) as entries:
        for count, entry in enumerate(entries, start=1):
            metadata = entry.stat(follow_symlinks=False)
            temporary = re.fullmatch(r"\.ldp-state-[0-9a-f]{32}", entry.name) is not None
            if (
                count > MAX_UNINITIALIZED_ENTRIES
                or not (temporary or entry.name == "host-restore.lock")
                or not stat.S_ISREG(metadata.st_mode)
                or stat.S_IMODE(metadata.st_mode) != LOCK_MODE
                or metadata.st_uid != owner
                or metadata.st_gid != owner
                or metadata.st_nlink != 1
                or (not temporary and metadata.st_size != 0)
            ):
                raise ValueError("restore provenance lost its journal")


def require_lock(descriptor: int) -> None:
    opened = os.fstat(descriptor)
    named = (ARTIFACT_ROOT / "selection.lock").lstat()
    if (
        not stat.S_ISREG(opened.st_mode)
        or stat.S_IMODE(opened.st_mode) != LOCK_MODE
        or opened.st_uid != 0
        or opened.st_gid != 0
        or opened.st_nlink != 1
        or opened.st_size != 0
        or (opened.st_dev, opened.st_ino) != (named.st_dev, named.st_ino)
    ):
        raise ValueError("unsafe selection lease")


def acquire_selection() -> int:
    descriptor = os.open(
        ARTIFACT_ROOT / "selection.lock", os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC
    )
    try:
        require_lock(descriptor)
        deadline = time.monotonic() + 5
        while True:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_SH | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise
                time.sleep(0.05)
        require_lock(descriptor)
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def require_artifact() -> pathlib.Path:
    selector = ARTIFACT_ROOT / "current"
    metadata = selector.lstat()
    selected = selector.readlink()
    if (
        not stat.S_ISLNK(metadata.st_mode)
        or metadata.st_uid != 0
        or metadata.st_gid != 0
        or metadata.st_nlink != 1
        or selected.parent != ARTIFACT_ROOT
        or re.fullmatch(r"[0-9a-f]{64}", selected.name) is None
    ):
        raise ValueError("unsafe selected artifact")
    subprocess.run(  # noqa: S603 - fixed verifier before importing selected root code
        ["/usr/local/libexec/lowerduckpond/verify-static-host-agent-artifact", str(selected)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env={"PATH": "/usr/bin:/bin"},
        check=True,
        timeout=10,
    )
    return selected


def main() -> int:  # noqa: PLR0911 - explicit boot and admission failure boundaries
    if sys.argv[1:] not in (["--boot"], ["--ordinary"], ["--caddy"]):
        return 64
    if os.geteuid() != 0:
        return 77
    boot = sys.argv[1] == "--boot"
    try:
        if not os.path.lexists(ROOT):
            return 0
        metadata = ROOT.lstat()
        if (
            not stat.S_ISDIR(metadata.st_mode)
            or stat.S_IMODE(metadata.st_mode) != PRIVATE_MODE
            or metadata.st_uid != 0
            or metadata.st_gid != 0
        ):
            raise ValueError("unsafe recovery root")
        marker = os.path.lexists(ROOT / "restore-gate.json")
        journal = os.path.lexists(ROOT / "host-restore.json")
        if not marker and not journal:
            require_uninitialized_directory(ROOT)
            return 0
        if marker and boot:
            close_firewall()
            return 0
        if marker and sys.argv[1] == "--ordinary":
            return 78
        descriptor = acquire_selection()
        try:
            selected = require_artifact()
            sys.path.insert(0, str(selected / "site-packages"))
            from lowerduckpond_static_host_agent.host_restore_gate import (  # noqa: PLC0415 - verify selected code before import
                restore_admission,
            )

            admitted = restore_admission(caddy=sys.argv[1] == "--caddy", boot=boot)
            if not admitted and boot:
                close_firewall()
                return 0
            return 0 if admitted else 78
        finally:
            os.close(descriptor)
    except Exception:
        if boot:
            close_firewall()
        return 78


if __name__ == "__main__":
    status = main()
    if status:
        print("host_restore_pending", file=sys.stderr)
    raise SystemExit(status)
