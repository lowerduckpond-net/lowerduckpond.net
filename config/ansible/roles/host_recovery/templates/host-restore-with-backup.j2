#!/usr/bin/env bash
set -euo pipefail
umask 077

if (( EUID != 0 )); then
    echo restore_root_required >&2
    exit 77
fi
exec 9</var/cache/lowerduckpond-backup/repository.lock
flock --exclusive 9
# Source only the installed root-owned configuration after repository exclusion.
# shellcheck disable=SC1091
source /etc/lowerduckpond/backup.env
if [[ "${LOWERDUCKPOND_BACKUP_ACTIVATION_SCOPE:-}" != {{ backup_activation_scope | quote }} ]]; then
    echo restore_configuration_scope_changed >&2
    exit 1
fi
export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_DEFAULT_REGION
export RESTIC_PASSWORD RESTIC_REPOSITORY RESTIC_CACHE_DIR
export LOWERDUCKPOND_BACKUP_NODE_NAME
export LOWERDUCKPOND_BACKUP_STATIC_RECOVERY_ENABLED LOWERDUCKPOND_AUDIT_ROTATION_ENABLED
exec /usr/local/libexec/lowerduckpond/{{ item.agent }} "$@"
