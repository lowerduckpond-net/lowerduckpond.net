[Unit]
Requires=lowerduckpond-restore-gate.service
After=lowerduckpond-restore-gate.service
{% if item.endswith('.timer') or item.endswith('.socket') %}
ConditionPathExists=|!/var/lib/lowerduckpond/recovery/restore-gate.json
ConditionPathExists=|/run/lowerduckpond-host-restore/schedules-ready
{% elif item != 'caddy.service' %}
ConditionPathExists=!/var/lib/lowerduckpond/recovery/restore-gate.json
{% endif %}

{% if item.endswith('.service') %}
[Service]
BindReadOnlyPaths=/var/lib/lowerduckpond/recovery
# Read private provenance as root while retaining the service sandbox. A full
# privilege (+) prefix keeps the empty tmpfs root but omits its cgroup mount,
# so systemd cannot prepare memory.pressure on hosts with PSI enabled.
ExecStartPre=!/usr/local/libexec/lowerduckpond/host-restore-gate {{ '--caddy' if item == 'caddy.service' else '--ordinary' }}
{% endif %}
