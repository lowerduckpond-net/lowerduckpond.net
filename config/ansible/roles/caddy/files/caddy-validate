#!/usr/bin/env bash
set -euo pipefail

if (( $# < 1 || $# > 2 )); then
    echo "usage: caddy-validate Caddyfile [routes-glob]" >&2
    exit 2
fi
if (( EUID != 0 )); then
    echo "caddy-validate must start as root before dropping to the caddy account" >&2
    exit 77
fi

configuration=$1
candidate_routes_glob=${2:-}
if [[ ! -f "${configuration}" || -L "${configuration}" ]]; then
    echo "caddy-validate requires a regular, non-symlink configuration" >&2
    exit 66
fi
validation_root=
cleanup() {
    if [[ -n "${validation_root}" ]]; then
        find "${validation_root}" -depth -delete
    fi
}
trap cleanup EXIT

validation_root=$(mktemp -d \
    "${TMPDIR:-/tmp}/lowerduckpond-caddy-validate.XXXXXXXX")
chown root:caddy "${validation_root}"
chmod 0750 "${validation_root}"
install -o root -g caddy -m 0440 \
    "${configuration}" "${validation_root}/Caddyfile"
install -d -o caddy -g caddy -m 0700 \
    "${validation_root}/data" "${validation_root}/tmp"

set -a
# shellcheck disable=SC1091
source /etc/caddy/environment
if [[ -n "${candidate_routes_glob}" ]]; then
    CADDY_ROUTES_GLOB=${candidate_routes_glob}
fi
HOME=/var/lib/caddy
LOGNAME=caddy
TMPDIR=${validation_root}/tmp
USER=caddy
XDG_CONFIG_HOME=/etc/caddy
XDG_DATA_HOME=${validation_root}/data
set +a
/usr/bin/setpriv \
    --reuid=caddy \
    --regid=caddy \
    --init-groups \
    --no-new-privs \
    /usr/local/bin/caddy validate \
    --config "${validation_root}/Caddyfile" \
    --adapter caddyfile
