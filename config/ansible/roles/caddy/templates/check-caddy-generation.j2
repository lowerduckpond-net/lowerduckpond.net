#!/usr/bin/env bash
set -euo pipefail
umask 077

exec /usr/local/libexec/lowerduckpond/bootstrap-caddy-generation \
    {{ static_host_agent_artifact_sha256 | quote }} \
    --authoritative-check \
    {{ ('--origin-pull-required' if caddy_origin_pull_enforcement_enabled | bool else '--origin-pull-staged') | quote }} \
    {{ caddy_binary_path | quote }} \
    {{ caddy_generation_binary.stat.checksum | quote }} \
    /etc/caddy/environment \
{% for path in caddy_installed_origin_pull_ca_paths %}
    {{ path | quote }}{{ ' \\' if not loop.last else '' }}
{% endfor %}
