[Unit]
Description=Lower Duck Pond immutable Caddy edge
Documentation=https://caddyserver.com/docs/
After=network-online.target caddy-recovery.service
Wants=network-online.target caddy-recovery.service
OnFailure=caddy-recovery.service
StartLimitBurst=3
StartLimitIntervalSec=60s

[Service]
Type=notify
User=caddy
Group=caddy
OpenFile={{ caddy_publication_lock_path }}:publication-lock
RuntimeDirectory={{ caddy_runtime_directory }}
RuntimeDirectoryMode=0750
ExecStartPre=+/usr/local/libexec/lowerduckpond/prepare-caddy-generation-start {{ static_host_agent_artifact_sha256 }}
ExecStart=/usr/local/libexec/lowerduckpond/launch-caddy-generation {{ static_host_agent_artifact_sha256 }}
ExecStartPost=/usr/bin/chmod 0620 {{ caddy_admin_socket_path }}
ExecStartPost=+/usr/local/libexec/lowerduckpond/verify-caddy-generation-start {{ static_host_agent_artifact_sha256 }}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=5s
LimitNOFILE=1048576
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ReadWritePaths=/etc/caddy /var/lib/caddy /var/log/caddy {{ caddy_publication_lock_path }}
UMask=0077

[Install]
WantedBy=multi-user.target
