# Rebuild the same server/client revisions formerly supplied by the retired
# quay.io/minio/minio image. This is a local test fixture, never a live provider.
FROM golang:1.24.6@sha256:8d9e57c5a6f2bede16fe674c16149eee20db6907129e02c4ad91ce5a697a4012 AS compiler
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOMAXPROCS=2

FROM compiler AS server
WORKDIR /source/minio
RUN git init \
    && git remote add origin https://github.com/minio/minio.git \
    && git fetch --depth=1 origin 07c3a429bfed433e49018cb0f78a52145d4bedeb \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = 07c3a429bfed433e49018cb0f78a52145d4bedeb \
    && go build -p=2 -mod=readonly -tags kqueue -trimpath \
        -ldflags "$(go run buildscripts/gen-ldflags.go)" -o /out/minio .

FROM compiler AS client
WORKDIR /source/mc
RUN git init \
    && git remote add origin https://github.com/minio/mc.git \
    && git fetch --depth=1 origin 7394ce0dd2a80935aded936b09fa12cbb3cb8096 \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = 7394ce0dd2a80935aded936b09fa12cbb3cb8096 \
    && go build -p=2 -mod=readonly -tags kqueue -trimpath \
        -ldflags "$(go run buildscripts/gen-ldflags.go)" -o /out/mc .

FROM python:3.14.7-slim-bookworm@sha256:82bc3c539b8813ada9d68c63b40158fa002f7f33de9bf3312a3dfdc0620dff56
LABEL net.lowerduckpond.fixture.minio-source=07c3a429bfed433e49018cb0f78a52145d4bedeb \
      net.lowerduckpond.fixture.mc-source=7394ce0dd2a80935aded936b09fa12cbb3cb8096
COPY --from=server /out/minio /usr/bin/minio
COPY --from=client /out/mc /usr/bin/mc
COPY --from=server /source/minio/LICENSE /source/minio/CREDITS /licenses/minio/
COPY --from=client /source/mc/LICENSE /source/mc/CREDITS /licenses/mc/
ENTRYPOINT ["/usr/bin/minio"]
CMD ["server", "/data"]
