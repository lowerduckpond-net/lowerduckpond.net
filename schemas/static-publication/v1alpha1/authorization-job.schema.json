{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lowerduckpond.net/static-publication/v1alpha1/authorization-job.schema.json",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "compatibilityVersion": {
            "const": "static-job-v2"
          }
        },
        "required": [
          "compatibilityVersion"
        ]
      },
      "then": {
        "required": [
          "executionValidated",
          "sourceAuthority"
        ]
      }
    }
  ],
  "properties": {
    "acceptedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "apiVersion": {
      "$ref": "common.schema.json#/$defs/apiVersion"
    },
    "artifact": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "compatibilityVersion": {
      "enum": [
        "static-job-v1",
        "static-job-v2"
      ]
    },
    "expectedSource": {
      "additionalProperties": false,
      "properties": {
        "archiveRecordDigest": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/archiveRecordDigest"
            },
            {
              "type": "null"
            }
          ]
        },
        "deploymentDigest": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/deploymentRecordDigest"
            },
            {
              "type": "null"
            }
          ]
        },
        "deletionEvidence": {
          "oneOf": [
            {
              "$ref": "audit-entry.schema.json#/$defs/deletionEvidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "expectsTenantAbsent": {
          "type": "boolean"
        },
        "lifecycle": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/lifecycle"
            },
            {
              "type": "null"
            }
          ]
        },
        "manifestDigest": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/manifestDigest"
            },
            {
              "type": "null"
            }
          ]
        },
        "platformStateDigest": {
          "$ref": "common.schema.json#/$defs/platformStateDigest"
        }
      },
      "required": [
        "expectsTenantAbsent",
        "lifecycle",
        "manifestDigest",
        "deploymentDigest",
        "archiveRecordDigest",
        "platformStateDigest"
      ],
      "type": "object"
    },
    "dispatchArchiveDeploymentIds": {
      "oneOf": [
        {
          "items": {
            "$ref": "common.schema.json#/$defs/uuidv7"
          },
          "maxItems": 3,
          "type": "array",
          "uniqueItems": true
        },
        {
          "type": "null"
        }
      ]
    },
    "dispatchArtifactReleaseTreeDigest": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/releaseTreeDigest"
        },
        {
          "type": "null"
        }
      ]
    },
    "dispatchDeploymentIds": {
      "oneOf": [
        {
          "items": {
            "$ref": "common.schema.json#/$defs/uuidv7"
          },
          "maxItems": 3,
          "type": "array",
          "uniqueItems": true
        },
        {
          "type": "null"
        }
      ]
    },
    "dispatchTenantIds": {
      "oneOf": [
        {
          "items": {
            "$ref": "common.schema.json#/$defs/uuidv7"
          },
          "maxItems": 25,
          "type": "array",
          "uniqueItems": true
        },
        {
          "type": "null"
        }
      ]
    },
    "executionValidated": {
      "type": "boolean"
    },
    "jobId": {
      "$ref": "common.schema.json#/$defs/uuidv7"
    },
    "kind": {
      "const": "AuthorizationJob"
    },
    "operatorPrincipal": {
      "$ref": "common.schema.json#/$defs/principal"
    },
    "phase": {
      "enum": [
        "pending",
        "claimed",
        "completed",
        "failed"
      ],
      "type": "string"
    },
    "request": {
      "$ref": "operation-request.schema.json"
    },
    "requestDigest": {
      "$ref": "common.schema.json#/$defs/requestDigest"
    },
    "sourceAuthority": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "archiveRecord": {
              "oneOf": [
                {
                  "$ref": "archive-record.schema.json"
                },
                {
                  "type": "null"
                }
              ]
            },
            "manifest": {
              "$ref": "site.schema.json"
            }
          },
          "required": [
            "manifest",
            "archiveRecord"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "compatibilityVersion",
    "jobId",
    "operatorPrincipal",
    "request",
    "requestDigest",
    "artifact",
    "expectedSource",
    "acceptedAt",
    "phase"
  ],
  "type": "object"
}
