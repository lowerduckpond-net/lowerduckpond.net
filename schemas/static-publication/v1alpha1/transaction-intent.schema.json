{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lowerduckpond.net/static-publication/v1alpha1/transaction-intent.schema.json",
  "$defs": {
    "archiveRecovery": {
      "additionalProperties": false,
      "properties": {
        "candidateArchiveRecord": {
          "$ref": "archive-record.schema.json"
        },
        "candidateManifest": {
          "$ref": "site.schema.json",
          "properties": {
            "spec": {
              "properties": {
                "desiredState": {
                  "const": "archived"
                }
              },
              "required": [
                "desiredState"
              ]
            }
          }
        },
        "candidateRouteSet": {
          "const": "absent"
        },
        "candidateRuntimeGenerationId": {
          "$ref": "common.schema.json#/$defs/uuidv7"
        },
        "sourceManifest": {
          "$ref": "site.schema.json",
          "properties": {
            "spec": {
              "properties": {
                "desiredState": {
                  "enum": [
                    "active",
                    "suspended"
                  ]
                }
              },
              "required": [
                "desiredState"
              ]
            }
          }
        },
        "sourceObservedState": {
          "$ref": "tenant-observed-state.schema.json",
          "properties": {
            "observedState": {
              "enum": [
                "active",
                "suspended"
              ]
            }
          }
        },
        "sourceRouteSet": {
          "enum": [
            "both",
            "absent"
          ],
          "type": "string"
        },
        "sourceRuntimeGenerationId": {
          "$ref": "common.schema.json#/$defs/uuidv7"
        }
      },
      "required": [
        "sourceManifest",
        "sourceObservedState",
        "sourceRuntimeGenerationId",
        "sourceRouteSet",
        "candidateManifest",
        "candidateArchiveRecord",
        "candidateRuntimeGenerationId",
        "candidateRouteSet"
      ],
      "type": "object"
    },
    "lifecycleRecovery": {
      "additionalProperties": false,
      "properties": {
        "candidateObservedState": {
          "oneOf": [
            {
              "$ref": "tenant-observed-state.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidateRouteSet": {
          "enum": [
            "both",
            "absent"
          ],
          "type": "string"
        },
        "candidateRuntimeGenerationId": {
          "$ref": "common.schema.json#/$defs/uuidv7"
        },
        "sourceObservedState": {
          "oneOf": [
            {
              "$ref": "tenant-observed-state.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceRouteSet": {
          "enum": [
            "both",
            "absent"
          ],
          "type": "string"
        },
        "sourceRuntimeGenerationId": {
          "$ref": "common.schema.json#/$defs/uuidv7"
        }
      },
      "required": [
        "sourceObservedState",
        "sourceRuntimeGenerationId",
        "sourceRouteSet",
        "candidateObservedState",
        "candidateRuntimeGenerationId",
        "candidateRouteSet"
      ],
      "type": "object"
    },
    "restartFence": {
      "additionalProperties": false,
      "properties": {
        "candidateAttemptCount": {
          "maximum": 3,
          "minimum": 0,
          "type": "integer"
        },
        "recoveryAttemptCount": {
          "maximum": 3,
          "minimum": 0,
          "type": "integer"
        },
        "selectedTarget": {
          "enum": [
            "candidate",
            "previous"
          ],
          "type": "string"
        },
        "systemdInvocationId": {
          "oneOf": [
            {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "selectedTarget",
        "candidateAttemptCount",
        "recoveryAttemptCount",
        "systemdInvocationId"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "compatibilityVersion"
        ]
      },
      "then": {
        "properties": {
          "compatibilityVersion": {
            "const": "static-intent-v2"
          }
        },
        "required": [
          "sourceManifest",
          "candidateManifest"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "sourceManifest"
              ]
            },
            {
              "required": [
                "candidateManifest"
              ]
            }
          ]
        }
      }
    },
    {
      "else": {
        "properties": {
          "sourceManifest": {
            "$ref": "site.schema.json"
          },
          "sourceManifestDigest": {
            "$ref": "common.schema.json#/$defs/manifestDigest"
          }
        }
      },
      "if": {
        "properties": {
          "operation": {
            "const": "create"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "sourceManifest": {
            "type": "null"
          },
          "sourceManifestDigest": {
            "type": "null"
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "candidateManifestDigest": {
            "$ref": "common.schema.json#/$defs/manifestDigest"
          }
        }
      },
      "if": {
        "properties": {
          "operation": {
            "const": "delete"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "candidateManifestDigest": {
            "type": "null"
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "candidateManifest": {
            "$ref": "site.schema.json"
          }
        }
      },
      "if": {
        "properties": {
          "operation": {
            "const": "delete"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "candidateManifest": {
            "type": "null"
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "archiveRecovery": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "operation": {
            "const": "archive"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "archiveRecovery": {
            "$ref": "#/$defs/archiveRecovery"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "archive",
              "export"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "lifecycleRecovery": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "lifecycleRecovery": {
            "$ref": "#/$defs/lifecycleRecovery"
          }
        }
      }
    }
  ],
  "properties": {
    "apiVersion": {
      "$ref": "common.schema.json#/$defs/apiVersion"
    },
    "archiveRecovery": {
      "oneOf": [
        {
          "$ref": "#/$defs/archiveRecovery"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidateManifest": {
      "oneOf": [
        {
          "$ref": "site.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidateManifestDigest": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/manifestDigest"
        },
        {
          "type": "null"
        }
      ]
    },
    "compatibilityVersion": {
      "const": "static-intent-v2"
    },
    "correlationId": {
      "$ref": "common.schema.json#/$defs/correlationId"
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "intentId": {
      "$ref": "common.schema.json#/$defs/uuidv7"
    },
    "kind": {
      "const": "TransactionIntent"
    },
    "lifecycleRecovery": {
      "oneOf": [
        {
          "$ref": "#/$defs/lifecycleRecovery"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation": {
      "$ref": "common.schema.json#/$defs/operation"
    },
    "phase": {
      "enum": [
        "prepared",
        "runtime-selected",
        "restart-required",
        "candidate-starting",
        "rollback-restart-required",
        "recovery-starting",
        "state-committed"
      ],
      "type": "string"
    },
    "restartFence": {
      "oneOf": [
        {
          "$ref": "#/$defs/restartFence"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceManifestDigest": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/manifestDigest"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceManifest": {
      "oneOf": [
        {
          "$ref": "site.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "tenantId": {
      "$ref": "common.schema.json#/$defs/uuidv7"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "intentId",
    "tenantId",
    "correlationId",
    "operation",
    "archiveRecovery",
    "lifecycleRecovery",
    "sourceManifestDigest",
    "candidateManifest",
    "candidateManifestDigest",
    "phase",
    "restartFence",
    "createdAt"
  ],
  "type": "object"
}
