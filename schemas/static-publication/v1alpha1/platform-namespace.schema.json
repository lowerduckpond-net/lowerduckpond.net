  "$id": "https://schemas.lowerduckpond.net/static-publication/v1alpha1/platform-namespace.schema.json",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "$ref": "common.schema.json#/$defs/apiVersion"
    },
    "initializedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "kind": {
