{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lowerduckpond.net/m3-12/v1/contracts.schema.json",
  "title": "M3.12 transaction and evidence contracts",
  "oneOf": [
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/admission"
    },
    {
      "$ref": "#/$defs/launch-intent"
    },
    {
      "$ref": "#/$defs/launch-receipt"
    },
    {
      "$ref": "#/$defs/seal"
    },
    {
      "$ref": "#/$defs/report"
    },
    {
      "$ref": "#/$defs/transaction"
    },
    {
      "$ref": "#/$defs/phase-receipt"
    },
    {
      "$ref": "#/$defs/rollback"
    },
    {
      "$ref": "#/$defs/requirement-proof"
    },
    {
      "$ref": "#/$defs/diagnostic"
    },
    {
      "$ref": "#/$defs/diagnostic-summary"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "uuid7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "uuid7Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}(?![\\s\\S])"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])",
      "format": "date-time"
    },
    "transport": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "docker-exec",
            "ssh"
          ]
        },
        "identitySha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "kind",
        "identitySha256"
      ],
      "additionalProperties": false
    },
    "container": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/sha256"
        },
        "image": {
          "$ref": "#/$defs/sha256"
        },
        "runLabel": {
          "$ref": "#/$defs/uuid7Hex"
        }
      },
      "required": [
        "id",
        "image",
        "runLabel"
      ],
      "additionalProperties": false
    },
    "droplet-observation": {
      "type": "object",
      "properties": {
        "format": {"const": "lowerduckpond-m3-12-droplet-observation-v1"},
        "metadata": {
          "type": "object",
          "properties": {
            "dropletId": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
            "ipv4": {"type": "string", "format": "ipv4"}
          },
          "required": ["dropletId", "ipv4"],
          "additionalProperties": false
        },
        "hostIdentity": {
          "type": "object",
          "properties": {
            "machineSha256": {"$ref": "#/$defs/sha256"},
            "systemUuidSha256": {"$ref": "#/$defs/sha256"},
            "hostKeySha256": {"$ref": "#/$defs/sha256"}
          },
          "required": ["machineSha256", "systemUuidSha256", "hostKeySha256"],
          "additionalProperties": false
        },
        "bootSha256": {"$ref": "#/$defs/sha256"},
        "state": {
          "type": "object",
          "properties": {
            "artifactSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
            "launchPresent": {"type": "boolean"},
            "publication": {"enum": ["absent", "dark", "enabled"]}
          },
          "required": ["artifactSha256", "launchPresent", "publication"],
          "additionalProperties": false
        }
      },
      "required": ["format", "metadata", "hostIdentity", "bootSha256", "state"],
      "additionalProperties": false
    },
    "droplet-enrollment": {
      "type": "object",
      "properties": {
        "format": {"const": "lowerduckpond-m3-12-droplet-enrollment-v1"},
        "runId": {"$ref": "#/$defs/uuid7"},
        "allocationSha256": {"$ref": "#/$defs/sha256"},
        "machineSha256": {"$ref": "#/$defs/sha256"},
        "systemUuidSha256": {"$ref": "#/$defs/sha256"},
        "hostKeySha256": {"$ref": "#/$defs/sha256"},
        "ipv4": {"type": "string", "format": "ipv4"},
        "productionExclusionsSha256": {"$ref": "#/$defs/sha256"}
      },
      "required": [
        "format", "runId", "allocationSha256", "machineSha256", "systemUuidSha256",
        "hostKeySha256", "ipv4", "productionExclusionsSha256"
      ],
      "additionalProperties": false
    },
    "droplet-production-exclusions": {
      "type": "object",
      "properties": {
        "format": {"const": "lowerduckpond-m3-12-droplet-production-exclusions-v1"},
        "dropletIds": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
          "minItems": 1,
          "uniqueItems": true
        },
        "addresses": {
          "type": "array",
          "items": {"type": "string", "format": "ipv4"},
          "minItems": 1,
          "uniqueItems": true
        },
        "identityDigests": {
          "type": "array",
          "items": {"$ref": "#/$defs/sha256"},
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["format", "dropletIds", "addresses", "identityDigests"],
      "additionalProperties": false
    },
    "droplet-launch-attempt": {
      "type": "object",
      "properties": {
        "format": {"const": "lowerduckpond-m3-12-droplet-launch-attempt-v1"},
        "binding": {"$ref": "#/$defs/binding"},
        "invocationId": {"$ref": "#/$defs/uuid7"},
        "leaseSha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["format", "binding", "invocationId", "leaseSha256"],
      "additionalProperties": false
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "targetKind": {
              "const": "installed-fixture"
            },
            "purpose": {
              "const": "installed-test"
            },
            "enrollmentSha256": {
              "$ref": "#/$defs/sha256"
            },
            "allocationSha256": {
              "$ref": "#/$defs/sha256"
            },
            "leaseDomainSha256": {
              "$ref": "#/$defs/sha256"
            },
            "inventorySha256": {
              "$ref": "#/$defs/sha256"
            },
            "stateSha256": {
              "$ref": "#/$defs/sha256"
            },
            "addressSetSha256": {
              "$ref": "#/$defs/sha256"
            },
            "transactionNamespaceSha256": {
              "$ref": "#/$defs/sha256"
            },
            "transport": {
              "$ref": "#/$defs/transport"
            },
            "docker": {
              "type": "object",
              "properties": {
                "endpointSha256": {
                  "$ref": "#/$defs/sha256"
                },
                "daemonObservationSha256": {
                  "$ref": "#/$defs/sha256"
                },
                "ownerManifestSha256": {
                  "$ref": "#/$defs/sha256"
                },
                "runLabel": {
                  "$ref": "#/$defs/uuid7Hex"
                },
                "drainedAllocationSha256": {
                  "$ref": "#/$defs/sha256"
                },
                "roles": {
                  "type": "object",
                  "properties": {
                    "host": {
                      "$ref": "#/$defs/container"
                    },
                    "archive": {
                      "$ref": "#/$defs/container"
                    }
                  },
                  "required": [
                    "host",
                    "archive"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "endpointSha256",
                "daemonObservationSha256",
                "ownerManifestSha256",
                "runLabel",
                "drainedAllocationSha256",
                "roles"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "targetKind",
            "purpose",
            "enrollmentSha256",
            "allocationSha256",
            "leaseDomainSha256",
            "inventorySha256",
            "stateSha256",
            "addressSetSha256",
            "transactionNamespaceSha256",
            "transport",
            "docker"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "targetKind": {
              "const": "disposable-droplet"
            },
            "purpose": {
              "const": "disposable-qualification"
            },
            "enrollmentSha256": {
              "$ref": "#/$defs/sha256"
            },
            "allocationSha256": {
              "$ref": "#/$defs/sha256"
            },
            "leaseDomainSha256": {
              "$ref": "#/$defs/sha256"
            },
            "inventorySha256": {
              "$ref": "#/$defs/sha256"
            },
            "stateSha256": {
              "$ref": "#/$defs/sha256"
            },
            "addressSetSha256": {
              "$ref": "#/$defs/sha256"
            },
            "transactionNamespaceSha256": {
              "$ref": "#/$defs/sha256"
            },
            "transport": {
              "$ref": "#/$defs/transport"
            },
            "droplet": {
              "type": "object",
              "properties": {
                "projectIdSha256": {
                  "$ref": "#/$defs/sha256"
                },
                "dropletId": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "providerIdentitySha256": {
                  "$ref": "#/$defs/sha256"
                },
                "metadataIdentitySha256": {
                  "$ref": "#/$defs/sha256"
                }
              },
              "required": [
                "projectIdSha256",
                "dropletId",
                "providerIdentitySha256",
                "metadataIdentitySha256"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "targetKind",
            "purpose",
            "enrollmentSha256",
            "allocationSha256",
            "leaseDomainSha256",
            "inventorySha256",
            "stateSha256",
            "addressSetSha256",
            "transactionNamespaceSha256",
            "transport",
            "droplet"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "targetKind": {
              "const": "production-host"
            },
            "purpose": {
              "const": "production"
            },
            "enrollmentSha256": {
              "$ref": "#/$defs/sha256"
            },
            "allocationSha256": {
              "$ref": "#/$defs/sha256"
            },
            "leaseDomainSha256": {
              "$ref": "#/$defs/sha256"
            },
            "inventorySha256": {
              "$ref": "#/$defs/sha256"
            },
            "stateSha256": {
              "$ref": "#/$defs/sha256"
            },
            "addressSetSha256": {
              "$ref": "#/$defs/sha256"
            },
            "transactionNamespaceSha256": {
              "$ref": "#/$defs/sha256"
            },
            "transport": {
              "$ref": "#/$defs/transport"
            },
            "droplet": {
              "type": "object",
              "properties": {
                "projectIdSha256": {
                  "$ref": "#/$defs/sha256"
                },
                "dropletId": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "providerIdentitySha256": {
                  "$ref": "#/$defs/sha256"
                },
                "metadataIdentitySha256": {
                  "$ref": "#/$defs/sha256"
                }
              },
              "required": [
                "projectIdSha256",
                "dropletId",
                "providerIdentitySha256",
                "metadataIdentitySha256"
              ],
              "additionalProperties": false
            },
            "predecessorSha256": {
              "$ref": "#/$defs/sha256"
            },
            "successorProposalSha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "targetKind",
            "purpose",
            "enrollmentSha256",
            "allocationSha256",
            "leaseDomainSha256",
            "inventorySha256",
            "stateSha256",
            "addressSetSha256",
            "transactionNamespaceSha256",
            "transport",
            "droplet",
            "predecessorSha256",
            "successorProposalSha256"
          ],
          "additionalProperties": false
        }
      ]
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "targetKind": {
              "const": "installed-fixture"
            },
            "purpose": {
              "const": "installed-test"
            },
            "runId": {
              "$ref": "#/$defs/uuid7"
            },
            "targetSha256": {
              "$ref": "#/$defs/sha256"
            },
            "candidateSha256": {
              "$ref": "#/$defs/sha256"
            },
            "platformSha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "targetKind",
            "purpose",
            "runId",
            "targetSha256",
            "candidateSha256",
            "platformSha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "targetKind": {
              "const": "disposable-droplet"
            },
            "purpose": {
              "const": "disposable-qualification"
            },
            "runId": {
              "$ref": "#/$defs/uuid7"
            },
            "targetSha256": {
              "$ref": "#/$defs/sha256"
            },
            "candidateSha256": {
              "$ref": "#/$defs/sha256"
            },
            "platformSha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "targetKind",
            "purpose",
            "runId",
            "targetSha256",
            "candidateSha256",
            "platformSha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "targetKind": {
              "const": "production-host"
            },
            "purpose": {
              "const": "production"
            },
            "runId": {
              "$ref": "#/$defs/uuid7"
            },
            "targetSha256": {
              "$ref": "#/$defs/sha256"
            },
            "candidateSha256": {
              "$ref": "#/$defs/sha256"
            },
            "platformSha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "targetKind",
            "purpose",
            "runId",
            "targetSha256",
            "candidateSha256",
            "platformSha256"
          ],
          "additionalProperties": false
        }
      ]
    },
    "candidate": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
        },
        "inputPolicySha256": {
          "$ref": "#/$defs/sha256"
        },
        "inputFingerprintSha256": {
          "$ref": "#/$defs/sha256"
        },
        "hostAgentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "toolchainSha256": {
          "$ref": "#/$defs/sha256"
        },
        "requirementsSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "revision",
        "inputPolicySha256",
        "inputFingerprintSha256",
        "hostAgentSha256",
        "toolchainSha256",
        "requirementsSha256"
      ],
      "additionalProperties": false
    },
    "platform": {
      "type": "object",
      "properties": {
        "namespaceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "storageTargetSha256": {
          "$ref": "#/$defs/sha256"
        },
        "storageBackend": {
          "enum": [
            "minio",
            "spaces"
          ]
        },
        "cloudflareNetworkSetSha256": {
          "$ref": "#/$defs/sha256"
        },
        "trustedPlatformDomain": {
          "const": "lowerduckpond.net"
        },
        "aliasSuffix": {
          "const": "lowerduckpond.com"
        },
        "tenantOriginSuffix": {
          "const": "lowerduckpond.com"
        },
        "cookiePolicyVersion": {
          "const": "lowerduckpond-cookie-policy-v1"
        },
        "edgePolicyVersion": {
          "const": "lowerduckpond-edge-policy-v1"
        }
      },
      "required": [
        "namespaceSha256",
        "storageTargetSha256",
        "storageBackend",
        "cloudflareNetworkSetSha256",
        "trustedPlatformDomain",
        "aliasSuffix",
        "tenantOriginSuffix",
        "cookiePolicyVersion",
        "edgePolicyVersion"
      ],
      "additionalProperties": false
    },
    "prerequisites": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "component": {
              "$ref": "#/$defs/sha256"
            },
            "transportBootstrap": {
              "$ref": "#/$defs/sha256"
            },
            "darkStage": {
              "$ref": "#/$defs/sha256"
            },
            "darkRepeat": {
              "$ref": "#/$defs/sha256"
            },
            "targetSafety": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "component",
            "transportBootstrap",
            "darkStage",
            "darkRepeat",
            "targetSafety"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "$ref": "#/$defs/sha256"
            },
            "transportBootstrap": {
              "$ref": "#/$defs/sha256"
            },
            "darkStage": {
              "$ref": "#/$defs/sha256"
            },
            "darkRepeat": {
              "$ref": "#/$defs/sha256"
            },
            "targetSafety": {
              "$ref": "#/$defs/sha256"
            },
            "livePreflight": {
              "$ref": "#/$defs/sha256"
            },
            "predecessor": {
              "$ref": "#/$defs/sha256"
            },
            "successor": {
              "$ref": "#/$defs/sha256"
            },
            "backupRestore": {
              "$ref": "#/$defs/sha256"
            },
            "completeDisposable": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "component",
            "transportBootstrap",
            "darkStage",
            "darkRepeat",
            "targetSafety",
            "livePreflight",
            "predecessor",
            "successor",
            "backupRestore",
            "completeDisposable"
          ],
          "additionalProperties": false
        }
      ]
    },
    "receipt": {
      "type": "object",
      "properties": {
        "format": {
          "const": "lowerduckpond-m3-12-receipt-v1"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "invocationId": {
          "$ref": "#/$defs/uuid7"
        },
        "kind": {
          "enum": [
            "component",
            "transport-bootstrap",
            "dark-stage",
            "dark-repeat",
            "target-safety",
            "live-preflight",
            "accepted-predecessor",
            "successor-lease",
            "final-backup-restore",
            "functional",
            "accounting",
            "teardown",
            "canary",
            "acceptance"
          ]
        },
        "startedAt": {
          "$ref": "#/$defs/time"
        },
        "finishedAt": {
          "$ref": "#/$defs/time"
        },
        "oldestSupportingAt": {
          "$ref": "#/$defs/time"
        },
        "observationSha256": {
          "$ref": "#/$defs/sha256"
        },
        "outcome": {
          "const": "passed"
        }
      },
      "required": [
        "format",
        "binding",
        "invocationId",
        "kind",
        "startedAt",
        "finishedAt",
        "oldestSupportingAt",
        "observationSha256",
        "outcome"
      ],
      "additionalProperties": false
    },
    "admission": {
      "type": "object",
      "properties": {
        "format": {
          "const": "lowerduckpond-m3-12-admission-v1"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "platform": {
          "$ref": "#/$defs/platform"
        },
        "invocationId": {
          "$ref": "#/$defs/uuid7"
        },
        "authoritySha256": {
          "$ref": "#/$defs/sha256"
        },
        "leaseSha256": {
          "$ref": "#/$defs/sha256"
        },
        "preparedAt": {
          "$ref": "#/$defs/time"
        },
        "prerequisites": {
          "$ref": "#/$defs/prerequisites"
        }
      },
      "required": [
        "format",
        "binding",
        "target",
        "candidate",
        "platform",
        "invocationId",
        "authoritySha256",
        "leaseSha256",
        "preparedAt",
        "prerequisites"
      ],
      "additionalProperties": false
    },
    "launch-intent": {
      "type": "object",
      "properties": {
        "format": {
          "const": "lowerduckpond-m3-12-launch-intent-v1"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "admissionSha256": {
          "$ref": "#/$defs/sha256"
        },
        "invocationId": {
          "$ref": "#/$defs/uuid7"
        },
        "leaseSha256": {
          "$ref": "#/$defs/sha256"
        },
        "intendedAt": {
          "$ref": "#/$defs/time"
        }
      },
      "required": [
        "format",
        "binding",
        "admissionSha256",
        "invocationId",
        "leaseSha256",
        "intendedAt"
      ],
      "additionalProperties": false
    },
    "launch-receipt": {
      "type": "object",
      "properties": {
        "format": {
          "const": "lowerduckpond-m3-12-launch-receipt-v1"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "admissionSha256": {
          "$ref": "#/$defs/sha256"
        },
        "intentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "launchRecordSha256": {
          "$ref": "#/$defs/sha256"
        },
        "launchedAt": {
          "$ref": "#/$defs/time"
        }
      },
      "required": [
        "format",
        "binding",
        "admissionSha256",
        "intentSha256",
        "launchRecordSha256",
        "launchedAt"
      ],
      "additionalProperties": false
    },
    "completion": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "installed-diagnostic"
            },
            "binding": {
              "allOf": [
                {
                  "$ref": "#/$defs/binding"
                },
                {
                  "properties": {
                    "targetKind": {
                      "const": "installed-fixture"
                    },
                    "purpose": {
                      "const": "installed-test"
                    }
                  }
                }
              ]
            },
            "receipts": {
              "type": "object",
              "properties": {
                "functional": {
                  "$ref": "#/$defs/sha256"
